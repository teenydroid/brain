#!/usr/bin/env bash
# Measure a brain against the frozen tasks, and one brain against another.
#
#   bin/eval run [--samples N] [--only IDS | --tasks IDS] [--with-heldout]
#                [--brain DIR] [--key K] OUT
#       Draft every task in evals/tasks/ on the core at OH_URL, as the `act`
#       agent of whatever brain that core runs, N times each (default 2).
#       Each draft gets the hard checks. Writes OUT/drafts.jsonl, and
#       OUT/run.json with what was measured. A turn that fails (no answer
#       came back) is tried again, up to EVAL_TURN_TRIES times in all
#       (default 3), EVAL_RETRY_WAIT seconds apart (default 30, tripling),
#       within EVAL_RETRY_BUDGET seconds of waiting per run (default 900);
#       one that never answers is written as `no_sample`.
#       --brain is the brain the core serves (default OPENHUMAN_WORKSPACE,
#       else this checkout's brain/): a task's playbook prompt is read from
#       it, and run.json records its commit and a hash of what the act
#       turn's system prompt is built from.
#       --only IDS drafts those tasks afresh. --tasks IDS (a comma list; ""
#       is none, and drafts nothing) keeps an OUT whose run.json matches
#       (the same commit, prompt hash, samples and --key) and drafts only
#       the (task, sample) rows of IDS it is missing, has unrun, or drafted
#       from another message: one baseline OUT serves every candidate of a
#       generation, and later ones while main has not moved. A held-out id
#       in IDS is drafted only with --with-heldout and skipped without it.
#   bin/eval compare [--mode tournament|nonregression] [--tasks IDS] [--both-orders]
#                    [--judge-root DIR] [--threshold X] [--min-pairs N] [--with-heldout]
#                    [--judge-model M] BASE CAND OUT
#       Judge two runs pair by pair, blind, as the `judge` agent on the core
#       at OH_URL: each pair once, the baseline shown first on every other
#       pair judged and the candidate first on the rest, or twice with the
#       order swapped with --both-orders (the two must agree to decide a
#       pair).
#       --tasks judges and scores those tasks only. Writes OUT/judged.jsonl
#       and OUT/report.json, whose `verdict` is
#         tournament (the default): won | lost | inconclusive
#         nonregression:            pass | regressed | inconclusive
#         either, when --tasks names no visible task: unmeasurable
#       `promote` is true for won and pass. Exits 0 when promoted, 2 when
#       not (lost, regressed, inconclusive), 3 when unmeasurable (nothing
#       drafted or judged is needed: "no eval task reaches this change"),
#       1 on an error.
#       Inconclusive: more than a tenth of either side's samples never ran,
#       a task ran on neither side together, or (nonregression) fewer than
#       --min-pairs pairs were decided.
#       --judge-model (or EVAL_JUDGE_MODEL) runs every judge turn on model M
#       through the core's per-turn `model_override`, without editing the
#       frozen judge.toml; report.json records the model asked for.
#   bin/eval confirm [--judge-root DIR] [--judge-model M] COMPARE BASE CAND
#       Confirm the hard-check regressions a compare saw. COMPARE is that
#       compare's OUT; its report.json lists under `confirm` the tasks the
#       two-sample hard-check rule named (none when a fence failed). BASE and
#       CAND are fresh runs of just those tasks (`run --only`, more samples,
#       main's drafted afresh too, never the cached baseline). Their pairs are
#       judged (OUT/confirm-judged.jsonl), and the compare is scored again:
#       a task regresses only when, on the fresh pairs alone, the candidate
#       fails a hard check where main passed so much more often than the
#       other way round that two alike sides would do it under 5% of the time
#       (an exact sign test, the 5% shared among the tasks confirmed). One
#       that does not hold up is set aside and the rest of the verdict
#       stands; one whose fresh drafts did not run is inconclusive. The first
#       report is kept as OUT/first-report.json, the new one replaces
#       report.json with each task's test under `confirmation`. Exits as
#       compare does. With nothing to confirm it changes nothing.
#       With no suspect left but `confirm_pairs` true (a non-regression
#       check whose pairs alone said worse), BASE and CAND are instead a
#       fresh sample of every task the compare scored, both sides drafted
#       afresh; its pairs are judged once each, in an order balanced within
#       each task (OUT/confirm-pairs-judged.jsonl), and the candidate is worse
#       only if that sample alone is: its wins would come up under 20% of the
#       time for two alike sides. Else the verdict is the non-regression
#       pass. `pairs_confirmation` has the test. Run it once for each kind
#       the report asks for: suspects first, then pairs.
#   bin/eval affected --root DIR --base SHA
#       The tasks a change can reach: {"tasks": [ids], "all": bool, "why":
#       {id or "*": reason}, "paths": {path: reason}, "heldout": [ids]}
#       for what DIR's working tree changes against SHA (git diff, and
#       untracked files). docs/evolve.md, "Affected tasks", has the rule.
#
# Both keep EVAL_CONCURRENCY turns in flight at once (default 4, 1 to 16) and
# write their files in order all the same.
#
# --with-heldout also drafts (run) and judges (compare) the held-out tasks
# in $EVAL_HELDOUT_DIR (default secrets/heldout/*.toml, outside the public
# repository; same format as evals/tasks/). report.json shows them in a
# `heldout` block of their own; the verdict stays the visible tasks'.
# Without it, held-out drafts in a run are ignored.
#   bin/eval invariants [--root DIR]
#       The anchors in evals/invariants.md still match in DIR's brain.
#
# The evolve loop (docs/evolve.md) runs `run` on a lab spine serving the
# baseline and again on one serving the candidate, then `compare` on the live
# spine. What measures is never what is measured: the tasks, the rubric and
# the invariants are this checkout's evals/ (frozen), and the judge reads the
# soul, context and lore of --judge-root (default: this checkout, which is
# main), never the candidate's.
#
# A tournament promotes a candidate that fails no hard check more often than
# the baseline on any task, fails no fence check (the guard screen, a task's
# `fence` patterns, a fence invariant) on any sample, had at least
# --min-pairs pairs (default 12) decided, and won at least --threshold of
# them (default 0.6). A non-regression check passes one under the same
# hard-check and fence rules unless the evidence says it is worse: wins and
# losses over the decided pairs (ties dropped) are tested against two alike
# sides, each pair a fair coin, and it `regressed` only when so few wins would
# come up less than 1 time in 10 (an exact one-sided binomial test:
# 0 of 4 does, 1 of 4 does not, 10 of 28 does, 13 of 28 does not).
# --threshold is accepted there but ignored. --min-pairs defaults to half the
# pairs there could be, at most 12. report.json's `signal` reads `better`,
# `worse` or `no detectable difference` by the same 1 in 10 on either tail
# (`p_worse` and `p_better` are the two tails), in either mode. Nothing here
# posts, holds or writes to a core.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need jq python3

evals="$TEENY_ROOT/evals"
lib="$TEENY_ROOT/bin/lib/evals.py"
usage() {
  die "usage: bin/eval run [--samples N] [--only IDS | --tasks IDS] [--with-heldout] [--brain DIR] [--key K] OUT | compare [--mode tournament|nonregression] [--tasks IDS] [--both-orders] [--judge-root DIR] [--threshold X] [--min-pairs N] [--with-heldout] [--judge-model M] BASE CAND OUT | confirm [--judge-root DIR] [--judge-model M] COMPARE BASE CAND | affected --root DIR --base SHA | invariants [--root DIR]"
}
heldout_dir="${EVAL_HELDOUT_DIR:-$TEENY_SECRETS/heldout}"
# The held-out tasks, switched on for evals.py; dies when there are none.
with_heldout() {
  local ids
  ids="$(python3 "$lib" heldout-tasks "$evals" "$heldout_dir")" || die "the held-out tasks in $heldout_dir do not load"
  [ "$(jq length <<<"$ids")" -gt 0 ] || die "no held-out tasks in $heldout_dir"
  export EVAL_HELDOUT_DIR="$heldout_dir"
  jq -r 'join(" ")' <<<"$ids"
}
unset_heldout() { unset EVAL_HELDOUT_DIR; }
[ $# -gt 0 ] || usage
cmd="$1"
shift

run() {
  local samples=2 only="" tasks="" picked=0 out ids task heldout=0 held="" key="" resume=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --samples) samples="$2"; shift 2 ;;
      --only) only="$2"; shift 2 ;;
      --tasks) tasks="$2"; picked=1; shift 2 ;;
      --with-heldout) heldout=1; shift ;;
      --brain) OPENHUMAN_WORKSPACE="$(cd "$2" && pwd)" || die "no brain at $2"; export OPENHUMAN_WORKSPACE; shift 2 ;;
      --key) key="$2"; shift 2 ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  [ $# -eq 1 ] || usage
  [[ "$samples" =~ ^[1-9][0-9]?$ ]] || die "--samples is 1 to 99"
  if [ -n "$only" ] && [ "$picked" = 1 ]; then die "--only and --tasks do not go together"; fi
  out="$1"
  ids="$(python3 "$lib" tasks "$evals" | jq -r '[.[].id] | join(" ")')" || die "evals/tasks does not load"
  if [ "$heldout" = 1 ]; then
    held="$(with_heldout)" || exit 1
    export EVAL_HELDOUT_DIR="$heldout_dir"
    ids="$ids $held"
  else
    unset_heldout
  fi
  if [ -n "$only" ]; then
    for task in ${only//,/ }; do
      [[ " $ids " == *" $task "* ]] || die "no task $task in evals/tasks"
    done
    ids="${only//,/ }"
  fi
  if [ "$picked" = 1 ]; then
    ids="$(python3 "$lib" select "$evals" "$heldout_dir" "$heldout" "$tasks" | jq -r 'join(" ")')" || exit 1
    resume=(--resume)
  fi
  mkdir -p "$out"
  python3 "$lib" draft "$evals" "$TEENY_ROOT/hands/lib" "$out/drafts.jsonl" "$samples" "${ids// /,}" \
    "${resume[@]}" --key "$key" -- "$TEENY_ROOT/bin/ask" --agent act
}

compare() {
  local judge_root="$TEENY_ROOT" mode=tournament threshold="" min_pairs="" base cand out heldout=0
  local judge_model="${EVAL_JUDGE_MODEL:-}" tasks="" picked=0 both=() selected=() ids
  while [ $# -gt 0 ]; do
    case "$1" in
      --judge-root) judge_root="$(cd "$2" && pwd)"; shift 2 ;;
      --judge-model) judge_model="$2"; shift 2 ;;
      --with-heldout) heldout=1; shift ;;
      --threshold) threshold="$2"; shift 2 ;;
      --min-pairs) min_pairs="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --tasks) tasks="$2"; picked=1; shift 2 ;;
      --both-orders) both=(--both-orders); shift ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  [ $# -eq 3 ] || usage
  case "$mode" in
    tournament) threshold="${threshold:-0.6}" min_pairs="${min_pairs:-12}" ;;
    nonregression) threshold="${threshold:-0.5}" min_pairs="${min_pairs:-auto}" ;;
    *) die "--mode is tournament or nonregression" ;;
  esac
  base="$1/drafts.jsonl" cand="$2/drafts.jsonl" out="$3"
  if [ "$heldout" = 1 ]; then
    with_heldout >/dev/null || exit 1
    export EVAL_HELDOUT_DIR="$heldout_dir"
  else
    unset_heldout
  fi
  if [ "$picked" = 1 ]; then
    ids="$(python3 "$lib" select "$evals" "$heldout_dir" "$heldout" "$tasks" | jq -r 'join(",")')" || exit 1
    selected=(--tasks "$ids")
  fi
  mkdir -p "$out"
  : >"$out/judged.jsonl"
  # No visible task selected: nothing to draft or judge, and nothing decided.
  if [ "$picked" = 1 ] &&
    [ "$(python3 "$lib" select "$evals" "$heldout_dir" 0 "$ids" | jq length)" = 0 ]; then
    python3 "$lib" score /dev/null /dev/null "$out/judged.jsonl" "$threshold" "$min_pairs" --mode "$mode" "${selected[@]}" |
      jq --arg m "$judge_model" '. + {judge_model: (if $m == "" then null else $m end)}' >"$out/report.json.tmp"
    mv "$out/report.json.tmp" "$out/report.json"
    jq -c '{promote, verdict, reason}' "$out/report.json"
    exit 3
  fi
  if [ ! -s "$base" ] || [ ! -s "$cand" ]; then die "both runs need a drafts.jsonl"; fi
  # Every pair both sides drafted, judged once, or twice with --both-orders:
  # the baseline shown first, then the candidate. The judge never learns
  # which is which.
  local ask=("$TEENY_ROOT/bin/ask" --agent judge)
  [ -z "$judge_model" ] || ask+=(--model "$judge_model")
  python3 "$lib" judge "$evals" "$judge_root/brain" "$base" "$cand" "$out/judged.jsonl" "${both[@]}" "${selected[@]}" \
    -- "${ask[@]}" >/dev/null
  python3 "$lib" score "$base" "$cand" "$out/judged.jsonl" "$threshold" "$min_pairs" --mode "$mode" "${selected[@]}" |
    jq --arg m "$judge_model" '. + {judge_model: (if $m == "" then null else $m end)}' >"$out/report.json.tmp"
  mv "$out/report.json.tmp" "$out/report.json"
  summary "$out/report.json"
}

# REPORT's one summary line, and compare's exit: 0 promoted, 2 not.
summary() {
  jq -c '{promote, verdict, signal, reason, wins, losses, ties, decided, win_rate, regressions}
         + (if (.confirm // []) != [] then {confirm} else {} end)
         + (if .confirmation then {confirmation: (.confirmation | map_values(.state))} else {} end)
         + (if .confirm_pairs then {confirm_pairs} else {} end)
         + (if .pairs_confirmation then {pairs_confirmation: .pairs_confirmation.state} else {} end)
         + (if .path then {path} else {} end)
         + (if .heldout then {heldout: (.heldout | {won, wins, losses, ties, decided, win_rate})} else {} end)' "$1"
  [ "$(jq -r .promote "$1")" = true ] || exit 2
}

confirm() {
  local judge_root="$TEENY_ROOT" judge_model="${EVAL_JUDGE_MODEL:-}" out base cand tasks
  while [ $# -gt 0 ]; do
    case "$1" in
      --judge-root) judge_root="$(cd "$2" && pwd)"; shift 2 ;;
      --judge-model) judge_model="$2"; shift 2 ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  [ $# -eq 3 ] || usage
  out="$1" base="$2/drafts.jsonl" cand="$3/drafts.jsonl"
  [ -s "$out/report.json" ] || die "no report.json in $out"
  local kind=hard judged="$out/confirm-judged.jsonl"
  tasks="$(jq -r '(.confirm // []) | join(",")' "$out/report.json")" || die "$out/report.json does not read"
  if [ -z "$tasks" ] && [ "$(jq -r '.confirm_pairs // false' "$out/report.json")" = true ]; then
    kind=pairs judged="$out/confirm-pairs-judged.jsonl"
    tasks="$(jq -r '(.tasks // ([.pairs[].task] | unique)) | join(",")' "$out/report.json")"
  fi
  if [ -z "$tasks" ]; then
    summary "$out/report.json"
    exit 0
  fi
  if [ ! -s "$base" ] || [ ! -s "$cand" ]; then die "both confirmation runs need a drafts.jsonl"; fi
  unset_heldout
  local ask=("$TEENY_ROOT/bin/ask" --agent judge)
  [ -z "$judge_model" ] || ask+=(--model "$judge_model")
  python3 "$lib" judge "$evals" "$judge_root/brain" "$base" "$cand" "$judged" --tasks "$tasks" \
    -- "${ask[@]}" >/dev/null
  [ -e "$out/first-report.json" ] || cp "$out/report.json" "$out/first-report.json"
  python3 "$lib" rescore "$kind" "$out/report.json" "$base" "$cand" "$judged" |
    jq --arg m "$judge_model" '. + {judge_model: (if $m == "" then null else $m end)}' >"$out/report.json.tmp"
  mv "$out/report.json.tmp" "$out/report.json"
  summary "$out/report.json"
}

affected() {
  local root="" base=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) root="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  if [ -z "$root" ] || [ -z "$base" ]; then usage; fi
  [ -d "$root" ] || die "no checkout at $root"
  python3 "$lib" affected "$evals" "$heldout_dir" "$root" "$base"
}

invariants() {
  local root="$TEENY_ROOT"
  if [ "${1:-}" = --root ]; then
    root="$(cd "$2" && pwd)"
    shift 2
  fi
  [ $# -eq 0 ] || usage
  python3 "$lib" invariants "$evals" "$root/brain"
}

case "$cmd" in
  run | compare | confirm | affected | invariants) "$cmd" "$@" ;;
  *) usage ;;
esac
