#!/usr/bin/env bash
# What Teeny said it would build (docs/evolve.md, "1c. Wants"): the build-intent
# items of its memory page, drawn in code, handed at most one a day to the
# agentic mind through the guard, as a note in its inbox
# (state/home/notes/inbox/want-<id>.md), and a feature the retired builder
# built scored seven days after it merged. Off unless WANTS=1 in
# secrets/evolve.env. The work is bin/lib/wants.py.
#
#   bin/wants draw      the wants and where each stands (read-only)
#   bin/wants file      hand the top open want to the mind, if any
#   bin/wants watch     score each merged feature, once its week is over
#   bin/wants run       watch, then file: the `wants` job in brain/cron.toml
#                       (Teeny's to move; WANTS still gates every run)
#   bin/wants status    the wants, their standing and the last run
#
# One JSON line on stdout. Exit 0: ok; 1: an error, or a bad setting.
set -euo pipefail
exec python3 "$(dirname "${BASH_SOURCE[0]}")/lib/wants.py" "$@"
