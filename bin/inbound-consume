#!/usr/bin/env bash
# Answer what the core has drafted for: the sending side of the inbound
# path (docs/architecture.md, "Triggers").
#
#   bin/inbound-consume                       mentions (source x:mentions)
#   bin/inbound-consume --source mail:inbox   mail (bin/mail)
#
# For mail it is the same loop with hands/mail: `hands/mail ingest` offers
# messages (source mail:inbox, keyed on the thread), the tool-less
# `teeny-mail` agent drafts, and each reply goes through `hands/mail reply`
# ({message_id, body}) and is marked with `hands/mail mark`. Pacing is X's.
#
# `hands/x ingest` offers mentions to the core (`openhuman.inbound_offer`,
# source x:mentions). The core coalesces them and runs one turn of the
# tool-less `teeny-mentions` agent per batch, keeping its answer. This takes
# each completed answer (`openhuman.inbound_results`) and, per item:
#
#   reply  through `hands/x reply --to` (the guard, the posting rules and
#          DRY_RUN live there), but only to a mention in that batch: a draft
#          cannot pick whom it answers
#   skip   the mention is marked skipped
#
# A mention the core's prompt-injection guard kept out of the turn (the
# result's `blocked`) is marked held with the guard's reason. A mention in the
# batch the answer left out is skipped. Each mention's
# outcome goes to `hands/x mark`, and the answer is acknowledged
# (`openhuman.inbound_result_ack`) so it is handled once.
#
# Live replies are paced (REPLY_MIN/MAX_INTERVAL_MS, refused with the wait).
# A wait that fits in INBOUND_BUDGET_SECONDS (default 100, under cron's 120s
# wall) is slept; otherwise the answer is left unacknowledged and the next run
# picks it up where this one stopped: the replies already out are refused as
# `replied` and count as done.
#
# Prints one JSON summary per answer and appends it to
# state/inbound/runs.jsonl. Exits 0 when it ran, 1 on an error.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need jq python3

source=x:mentions
if [ "${1:-}" = --source ]; then
  source="${2:-}"
  shift 2 || true
fi
[ $# -eq 0 ] || die "usage: bin/inbound-consume [--source x:mentions|mail:inbox]"
case "$source" in
  x:mentions) hand=x lock=inbound-consume ;;
  mail:inbox) hand=mail lock=inbound-consume-mail ;;
  *) die "unknown inbound source: $source" ;;
esac

hands="${TEENY_HANDS:-$TEENY_ROOT/hands}"
dir="$TEENY_STATE/inbound"
mkdir -p "$dir" "$TEENY_STATE/locks"
record() { printf '%s\n' "$1" | tee -a "$dir/runs.jsonl"; }

# One consumer per source at a time: two would answer the same batch twice
# before either acknowledged it (the hand would still refuse the second reply).
exec 9>"$TEENY_STATE/locks/$lock.lock"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { log "already running"; exit 0; }
fi

# $source is one of the names above, so it is safe to write into the JSON.
results="$(oh inbound_results "$(printf '{"source": "%s", "status": "completed", "limit": 20}' "$source")")" ||
  die "could not read the core's results"
jq -e 'type == "object" and (.results | type == "array")' <<<"$results" >/dev/null ||
  die "unexpected answer from inbound_results"

budget="${INBOUND_BUDGET_SECONDS:-100}"
started="$(date +%s)"
mark() { (cd "$TEENY_ROOT" && "$hands/$hand" mark "$1" --status "$2" --note "$3" </dev/null >/dev/null) || true; }
# One draft item to its hand: X takes {text, gif_id?} and --to; mail takes
# {message_id, body}.
send_reply() { # ITEM TO
  if [ "$hand" = mail ]; then
    jq -c --arg to "$2" '{message_id: $to, body: (.text // "")}' <<<"$1" | (cd "$TEENY_ROOT" && "$hands/mail" reply)
  else
    jq -c '{text: (.text // "")} + (if .gif_id then {gif_id} else {} end)' <<<"$1" |
      (cd "$TEENY_ROOT" && "$hands/x" reply --to "$2")
  fi
}

while IFS= read -r turn; do
  turn_id="$(jq -r .turn_id <<<"$turn")"
  batch="$(jq -c '.event_ids // []' <<<"$turn")"
  blocked="$(jq -c '.blocked // []' <<<"$turn")"
  handled="$(jq -c '[.[].event_id]' <<<"$blocked")"
  actions='[]'
  paused=0
  if items="$(jq -r '.text // ""' <<<"$turn" | python3 "$TEENY_ROOT/bin/lib/answer.py" 2>"$dir/parse.err")"; then
    while IFS= read -r item; do
      action="$(jq -r .action <<<"$item")"
      to="$(jq -r '.to // .id // ""' <<<"$item")"
      if ! jq -e --arg to "$to" 'index($to) != null' <<<"$batch" >/dev/null; then
        actions="$(jq -c --arg a "$action" --arg to "$to" '. + [{action: $a, to: $to, refused: "not an event in this batch"}]' <<<"$actions")"
        continue
      fi
      handled="$(jq -c --arg to "$to" '. + [$to]' <<<"$handled")"
      case "$action" in
        skip)
          reason="$(jq -r '.reason // "skipped"' <<<"$item")"
          mark "$to" skipped "$reason"
          actions="$(jq -c --arg to "$to" --arg r "$reason" '. + [{action: "skip", to: $to, reason: $r}]' <<<"$actions")"
          ;;
        reply)
          while :; do
            status=0
            result="$(send_reply "$item" "$to")" || status=$?
            result="$(jq -c . <<<"$result" 2>/dev/null || jq -cn --arg r "$result" '{raw: $r}')"
            if [ "$status" != 2 ] || [ "$(jq -r '.rule // ""' <<<"$result")" != pacing ]; then break; fi
            wait="$(jq -r '.wait_seconds | ceil' <<<"$result")"
            if [ $(($(date +%s) - started + wait)) -gt "$budget" ]; then
              paused=1
              break
            fi
            sleep "$wait"
          done
          if [ "$paused" = 1 ]; then
            actions="$(jq -c --arg to "$to" '. + [{action: "reply", to: $to, status: "paused", reason: "pacing; the next run resumes"}]' <<<"$actions")"
            break
          fi
          if [ "$status" = 2 ] && [ "$(jq -r '.rule // ""' <<<"$result")" = replied ]; then
            mark "$to" replied "$(jq -r '.reply_id // ""' <<<"$result")"
          elif [ "$status" = 0 ] && jq -e '.dry_run == true' <<<"$result" >/dev/null; then
            mark "$to" drafted "dry run"
          elif [ "$status" = 0 ]; then
            mark "$to" replied "$(jq -r '.id // .reply_id // ""' <<<"$result")"
          elif [ "$status" = 2 ]; then
            mark "$to" refused "$(jq -r '.refused // "refused"' <<<"$result")"
          fi
          actions="$(jq -c --arg to "$to" --argjson s "$status" --argjson r "$result" \
            '. + [{action: "reply", to: $to, status: (if $s == 0 then "done" elif $s == 2 then "refused" else "error" end), result: $r}]' <<<"$actions")"
          ;;
        *)
          actions="$(jq -c --arg a "$action" --arg to "$to" '. + [{action: $a, to: $to, refused: "an inbound draft only replies or skips"}]' <<<"$actions")"
          ;;
      esac
    done < <(jq -c '.[]' <<<"$items")
  else
    actions="$(jq -cn --arg e "$(cat "$dir/parse.err")" '[{error: "the draft is not usable JSON: \($e)"}]')"
  fi
  if [ "$paused" = 1 ]; then
    record "$(jq -cn --arg s "$source" --arg t "$turn_id" --argjson b "$batch" --argjson a "$actions" \
      --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{at: $at, source: $s, turn_id: $t, mentions: $b, actions: $a, paused: true}')"
    break
  fi
  while IFS=$'\t' read -r id reason; do
    mark "$id" held "$reason"
  done < <(jq -r '.[] | [.event_id, .reason] | @tsv' <<<"$blocked")
  # Whatever the answer did not cover is not answered.
  while IFS= read -r left; do
    mark "$left" skipped "no answer in the draft"
  done < <(jq -r --argjson h "$handled" '.[] | select(. as $id | $h | index($id) | not)' <<<"$batch")
  oh inbound_result_ack "$(jq -cn --arg t "$turn_id" '{turn_id: $t}')" >/dev/null ||
    log "could not acknowledge $turn_id; it will be read again"
  record "$(jq -cn --arg s "$source" --arg t "$turn_id" --argjson b "$batch" --argjson a "$actions" --argjson k "$blocked" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{at: $at, source: $s, turn_id: $t, mentions: $b, actions: $a, blocked: $k}')"
done < <(jq -c '.results[]' <<<"$results")
