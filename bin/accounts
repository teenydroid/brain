#!/usr/bin/env bash
# Teeny's weekly accounts (evals/cron.pinned.toml, accounts; docs/roadmap.md,
# S1): `hands/wallet accounts close` reads every deposit to the wallet since
# the last scan into the inflow ledger (read only: nothing is signed), then
# freezes last week's profit and loss, what running Teeny cost against what it
# earned with the team's money shown apart, into state/hands.db, once. The
# receipts job publishes closed pages when ACCOUNTS_PUBLISH=1. Off unless
# secrets/teeny.env sets WALLET_ACCOUNTS=1 (skipped, exit 0, when off); an
# incomplete week (a cost source unread) is refused, never closed as profit.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"

hands="${TEENY_HANDS:-$TEENY_ROOT/hands}"
cd "$TEENY_ROOT"
exec "$hands/wallet" accounts close </dev/null
