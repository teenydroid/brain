#!/usr/bin/env bash
# Sweep Teeny's spare SOL to the surplus wallet (evals/cron.pinned.toml,
# surplus-sweep; docs/hands.md, "surplus"). `hands/surplus sweep`: pay the
# USDC on Base above SURPLUS_KEEP_BASE_USD to SURPLUS_ADDRESS (an allowlisted
# vendor on base), then bridge the SOL above SURPLUS_KEEP_SOL to Teeny's own
# USDC on Base for the next run to pay on. Every rule and cap of hands/wallet's
# pay and bridge holds. Off unless secrets/teeny.env sets SURPLUS_SWEEP=1
# (skipped, exit 0, when off: not a failed job).
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"

hands="${TEENY_HANDS:-$TEENY_ROOT/hands}"
cd "$TEENY_ROOT"
exec "$hands/surplus" sweep </dev/null
