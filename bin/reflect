#!/usr/bin/env bash
# Teeny's end of day: bring MEMORY.md up to date from the day, item by item
# (add, edit, retire against the items' ids, under a shrink check), on a
# thread of its own (teeny:reflect), and keep a diary entry (bin/lib/reflect.py;
# docs/architecture.md, 4a). The pinned `reflect` job runs it once a night;
# `reflect-midday` runs it with --light at 14:00, which updates the page only.
#
#   bin/reflect [--light]            # in the foreground; prints its result
#   bin/reflect [--light] --detach   # start it in the background, return at once
#
# The pinned jobs pass --detach: one long model turn can outlast the 300 s
# the core gives any cron shell call (docs/oh-gaps.md, G12). The detached
# reflection logs to state/reflect/reflect.log; while one is still running
# the call prints `"kind": "busy"` and starts nothing (bin/lib/detach.py).
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need python3 jq
args=()
detach=0
for arg in "$@"; do
  if [ "$arg" = --detach ]; then detach=1; else args+=("$arg"); fi
done
if [ "$detach" = 1 ]; then
  exec python3 "$TEENY_ROOT/bin/lib/detach.py" --log reflect/reflect.log --lock reflect -- \
    "$TEENY_ROOT/bin/reflect" ${args[@]+"${args[@]}"}
fi
exec python3 "$TEENY_ROOT/bin/lib/reflect.py" ${args[@]+"${args[@]}"}
