#!/usr/bin/env bash
# Make OpenHuman's cron match brain/cron.toml.
#
#   bin/seed-cron [--dry-run | --check] [--file brain/cron.toml] [--pinned evals/cron.pinned.toml]
#
# --check validates the file against the cron rules and stops: no core needed
# (bin/doctor, and the evolve gate on a candidate brain).
#
# OpenHuman cannot load jobs from a file (docs/oh-gaps.md, G2), so this
# reconciles by name: a job in the file and not in the core is added, one that
# differs is updated in place, and one in the core and not in the file is
# removed. It only ever touches jobs whose name starts with `teeny.`; the
# core's own system jobs (memory_background, ...) are left alone. Running it
# twice changes nothing the second time.
#
# Almost every job is a shell job running an operator script under bin/: a
# turn that cron starts may only use read-only tools (docs/architecture.md,
# §1), so the scripts act and the models only draft. The exception is an
# agent job (`agent` and `prompt`) for an agent written to act on a schedule
# (`scheduled_actions = true`, named tools: the builder and the operator);
# OpenHuman runs those as CronActions turns ("Scheduled agents"). Teeny owns
# brain/cron.toml; what its jobs may run, how often, and which jobs it cannot
# drop are bin/lib/cron_policy.py's rules, and the pinned jobs in
# evals/cron.pinned.toml are always merged in.
#
# A job that changes kind (shell to agent or back) is removed and added
# again: the core cannot change a job's type in place.
#
# An enabled job whose next run is already more than REARM_GRACE_SECS in the
# past is re-armed: its own schedule is patched back through `cron_update`,
# which moves next_run to the next slot. On 2026-11-11 the box rebooted in the
# middle of three runs; the dead process's claim on their slot outlived it
# (the core holds a run's claim for two hours), so the scheduler skipped them
# for over an hour after boot, and a restart did not help. Seeding runs at
# every boot (bin/spine), so a job stuck that way runs again at its next slot.
#
# Re-arming drops the slot it missed. For a job run every few minutes that is
# right; for a daily one it loses the day: on 2026-11-13 and 11-14 a deploy cut
# off teeny.self-improve mid-run, and this re-arm moved it to the next day both
# times, without an alarm (bin/health never saw it stale). So a job whose
# schedule says `catch_up = true` has its latest missed slot run once now
# (`cron_run`) when it is recent enough (bin/lib/catch_up.py: one job per
# boot, never the same slot twice, never a job seeding just added or
# changed); bin/health does the same every quarter of an hour, for the rest.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need jq python3

file="$TEENY_BRAIN/cron.toml"
pinned="$TEENY_ROOT/evals/cron.pinned.toml"
dry_run=0
check=0
# A slot a minute or two past is one the scheduler is about to run.
REARM_GRACE_SECS=120
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --check) check=1 ;;
    --file) file="$2"; shift ;;
    --pinned) pinned="$2"; shift ;;
    *) die "usage: bin/seed-cron [--dry-run | --check] [--file PATH] [--pinned PATH]" ;;
  esac
  shift
done
[ -r "$file" ] || die "no schedule file at $file"

# The file and the pinned jobs, checked against the cron rules
# (bin/lib/cron_policy.py) and flattened to one JSON array:
#   [{name, kind, expr, tz, command, agent, prompt, enabled}]
# --check is the gate (bin/doctor, the evolve gate): every rule is an error
# there. A boot only switches off a catch-up a playbook edit made unsafe.
strict=()
[ "$check" = 1 ] && strict=(--strict)
desired="$(python3 "$TEENY_ROOT/bin/lib/cron_policy.py" "${strict[@]}" "$file" "$pinned" "${CALENDAR_TZ:-}")" ||
  die "invalid schedule file"
if [ "$check" = 1 ]; then
  log "$file is valid: $(jq length <<<"$desired") job(s), the pinned ones included"
  exit 0
fi

# The core's jobs that this script owns, in the same shape plus their id.
# (`.enabled // true` would read a disabled job as enabled: `//` treats false
# as missing.)
current="$(oh cron_list | jq -c '[.[] | select((.name // "") | startswith("teeny.")) |
  {id, name, kind: (if .job_type == "agent" then "agent" else "shell" end),
   expr: .schedule.expr, tz: (.schedule.tz // null),
   command: (if .job_type == "agent" then null else .command end),
   agent: (if .job_type == "agent" then .agent_id else null end),
   prompt: (if .job_type == "agent" then .prompt else null end),
   enabled: (if .enabled == null then true else .enabled end), next_run: (.next_run // null)}]')"

plan="$(jq -cn --argjson want "$desired" --argjson have "$current" '
  ($have | group_by(.name) | map({key: .[0].name, value: .}) | from_entries) as $byname
  | [ $want[] as $w
      | ($byname[$w.name] // []) as $hs
      | if ($hs | length) == 0 then {op: "add", job: $w}
        elif ($hs[0] | {kind, expr, tz, command, agent, prompt, enabled})
             == ($w | {kind, expr, tz, command, agent, prompt, enabled}) then {op: "keep", job: $w}
        elif $hs[0].kind != $w.kind then {op: "replace", id: $hs[0].id, job: $w}
        else {op: "update", id: $hs[0].id, job: $w} end ]
  + [ $have | group_by(.name)[] as $g
      | if ([$want[].name] | index($g[0].name)) == null then $g[] | {op: "remove", id, job: .}
        else $g[1:][] | {op: "remove", id, job: .} end ]')"

# The kept jobs whose next run is long past (an add or an update sets the
# schedule, and with it next_run, anyway): [{id, name, next_run, job}].
rearm="$(jq -cn --argjson plan "$plan" --argjson have "$current" --argjson grace "$REARM_GRACE_SECS" '
  def epoch: try (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch null;
  [$plan[] | select(.op == "keep") | .job] as $kept
  | [ $have | group_by(.name)[] | .[0] as $h
      | ($kept[] | select(.name == $h.name)) as $w
      | select($h.enabled and $h.next_run != null)
      | select(($h.next_run | epoch) as $t | $t != null and $t < now - $grace)
      | {id: $h.id, name: $h.name, next_run: $h.next_run, job: $w} ]')"

schedule() { jq -c '{kind: "cron", expr: .expr, tz: .tz}' <<<"$1"; }
# A shell job runs its command; an agent job runs its agent on its prompt, in
# a fresh session of its own, delivering nothing anywhere (the agent reports
# through its hands). A job is created enabled; one the file disables is
# switched off after.
add_job() {
  local job="$1" id
  id="$(oh cron_add "$(jq -c --argjson s "$(schedule "$job")" '
    if .kind == "agent"
    then {name, job_type: "agent", agent_id: .agent, prompt, session_target: "isolated", schedule: $s, delivery: {mode: "none"}}
    else {name, job_type: "shell", command, schedule: $s, delivery: {mode: "none"}} end' <<<"$job")" | jq -r .id)"
  if [ "$(jq -r .enabled <<<"$job")" = false ]; then
    oh cron_update "$(jq -cn --arg id "$id" '{job_id: $id, patch: {enabled: false}}')" >/dev/null
  fi
}
changed=0
while IFS= read -r step; do
  op="$(jq -r .op <<<"$step")"
  job="$(jq -c .job <<<"$step")"
  name="$(jq -r .name <<<"$job")"
  if [ "$op" = keep ]; then
    log "$(printf '%-6s %s' keep "$name")"
    continue
  fi
  log "$(printf '%-7s %s  %s' "$op" "$name" "$(jq -r '"\(.expr) \(.tz) " + (if .kind == "agent" then "agent:\(.agent)" else .command end)' <<<"$job")")"
  changed=$((changed + 1))
  [ "$dry_run" = 1 ] && continue
  case "$op" in
    add) add_job "$job" ;;
    replace)
      oh cron_remove "$(jq -cn --arg id "$(jq -r .id <<<"$step")" '{job_id: $id}')" >/dev/null
      add_job "$job"
      ;;
    update)
      oh cron_update "$(jq -cn --arg id "$(jq -r .id <<<"$step")" --argjson s "$(schedule "$job")" \
        --argjson j "$job" '{job_id: $id, patch: ({schedule: $s, enabled: $j.enabled} +
          (if $j.kind == "agent" then {prompt: $j.prompt, agent_id: $j.agent} else {command: $j.command} end))}')" >/dev/null
      ;;
    remove)
      oh cron_remove "$(jq -cn --arg id "$(jq -r .id <<<"$step")" '{job_id: $id}')" >/dev/null
      ;;
  esac
done < <(jq -c '.[]' <<<"$plan")

# Re-armed through bin/lib/catch_up.py's rearm, which leaves a job a recent
# claim holds alone (the core serves before this runs and may have claimed,
# on its first poll, a slot that passed while the box was down: re-arming it
# would fence that claim and let a catch-up run a second copy), reads the
# claim again right after each update, and puts a slot the core claimed in
# between in the catch-up ledger, so it is never run again. Never fails the
# boot: what this misses, bin/health re-arms at its next check.
rearmed_names=""
if [ "$(jq length <<<"$rearm")" -gt 0 ]; then
  rearm_args=(rearm --via-oh --state "$TEENY_STATE")
  [ "$dry_run" = 1 ] && rearm_args+=(--dry-run)
  if done_rearm="$(jq -c '[.[] | {id, name, next_run, schedule: {kind: "cron", expr: .job.expr, tz: .job.tz}}]' <<<"$rearm" |
    python3 "$TEENY_ROOT/bin/lib/catch_up.py" "${rearm_args[@]}")"; then
    while IFS= read -r line; do
      [ -n "$line" ] && log "$line"
    done < <(jq -r --argjson stale "$rearm" '
      (.rearmed[] as $n | $stale[] | select(.name == $n) | "rearm \(.name) (next_run was \(.next_run))"),
      (.running[] | "running \(.) (held by a recent claim, live or just-killed; not re-armed)"),
      (.raced[] | "claimed \(.) while it was re-armed (that run goes on unrecorded; it is not run again)"),
      (.errors | to_entries[] | "could not re-arm \(.key): \(.value)")' <<<"$done_rearm")
    rearmed_names="$(jq -r '.rearmed | join(",")' <<<"$done_rearm")"
  else
    log "re-arm did not run; bin/health re-arms a stuck job at its next check"
  fi
fi

# A missed slot of a `catch_up` job, run once now. Never fails the boot: a
# slot this misses, bin/health catches up at its next check.
fresh="$(jq -r '[.[] | select(.op == "add" or .op == "update" or .op == "replace") | .job.name] | join(",")' <<<"$plan")"
catch_args=(--via-oh --state "$TEENY_STATE" --fresh "$fresh" --rearmed "$rearmed_names")
[ "$dry_run" = 1 ] && catch_args+=(--dry-run)
if caught="$(python3 "$TEENY_ROOT/bin/lib/catch_up.py" "${catch_args[@]}" <<<"$desired")"; then
  verb="caught up"
  [ "$dry_run" = 1 ] && verb="catch up"
  while IFS= read -r line; do
    [ -n "$line" ] && log "$line"
  done < <(jq -r --arg v "$verb" '(.caught_up[] | "\($v) \(.name) (its \(.slot) slot)"),
    (.pending[] | "catch up \(.) at a later check"), (.deferred[] | "catch up \(.) after the quiet hours"),
    (.errors | to_entries[] | "could not catch up \(.key): \(.value)")' <<<"$caught")
else
  log "catch-up did not run; bin/health tries again at its next check"
fi

if [ "$dry_run" = 1 ]; then
  log "dry run: $changed change(s) not applied"
else
  log "$changed change(s) applied"
fi
