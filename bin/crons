#!/usr/bin/env bash
# Show the core's cron jobs and their last run.
#
#   bin/crons            every job, Teeny's and the core's own
#   bin/crons runs NAME  the last 20 runs of one job (NAME without `teeny.`
#                        works too)
#
# Read-only. The scheduler is OpenClaw's automations: the jobs and their run
# history come from `openclaw automations list|runs --json` through
# bin/lib/cron_store.py, the one adapter every reader uses (needs the Gateway
# running, as every automations command does). Never write here; changes go
# through `bin/seed-cron`.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need python3

store="$TEENY_ROOT/bin/lib/cron_store.py"

case "${1:-}" in
  "") python3 "$store" crons ;;
  runs)
    [ $# -eq 2 ] || die "usage: bin/crons runs NAME"
    name="$2"
    case "$name" in teeny.* | *:*) ;; *) name="teeny.$name" ;; esac
    [[ "$name" =~ ^[A-Za-z0-9._:-]+$ ]] || die "not a job name: $2"
    python3 "$store" runs-of "$name"
    ;;
  *) die "usage: bin/crons [runs NAME]" ;;
esac
