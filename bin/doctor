#!/usr/bin/env bash
# Is this checkout safe to boot? Is the running spine healthy?
#
#   bin/doctor                 the checks a boot needs (bin/spine runs these)
#   bin/doctor --root DIR      the same, on another checkout (a candidate brain)
#   bin/doctor --live          also the running core: /health, cron in step
#                              with brain/cron.toml, every enabled job's next
#                              run current, the heartbeat fresh, the
#                              browser loads and starts Chrome, each studio
#                              model answers one small turn
#   bin/doctor --full          also the hands' unit tests
#
# Teeny edits its own brain: SOUL.md, CONTEXT.md, playbooks, crons. This is
# the check that stands between an edit and a restart, so it is frozen with
# the rest of bin/ (docs/architecture.md, "Evolution"). It changes nothing:
# no core call that writes (but --live's studio model turn, which may give
# the core a model's context window, as any `bin/ask --model` does), no
# guard hold, no post.
#
# Prints one line per check on stderr and a JSON report on stdout, and writes
# the report to state/doctor.json (of the root it checked). The one other
# thing it writes is the model behind each role, under secrets/autonomy/
# (bin/lib/autonomy.py; docs/roadmap.md, G8). Exits 0 when
# every check passed, 1 when any failed.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need jq python3

live=0
full=0
root="$TEENY_ROOT"
while [ $# -gt 0 ]; do
  case "$1" in
    --live) live=1 ;;
    --full) full=1 ;;
    --root) root="$(cd "$2" && pwd)"; shift ;;
    *) die "usage: bin/doctor [--root DIR] [--live] [--full]" ;;
  esac
  shift
done
# Another root's brain, secrets and state, unless the environment moved them
# for this one.
if [ "$root" != "$TEENY_ROOT" ]; then
  brain="$root/brain" secrets="$root/secrets" state="$root/state"
else
  brain="$TEENY_BRAIN" secrets="$TEENY_SECRETS" state="$TEENY_STATE"
fi
storage="${TEENY_STORAGE:-$brain/storage.db}"
[ "$root" = "$TEENY_ROOT" ] || storage="$brain/storage.db"

report='[]'
failed=0
note() {
  local name="$1" status="$2" detail="$3"
  printf '%-4s %s: %s\n' "$([ "$status" = fail ] && echo FAIL || echo "$status")" "$name" "$detail" >&2
  [ "$status" = fail ] && failed=$((failed + 1))
  report="$(jq -c --arg n "$name" --arg s "$status" --arg d "$detail" '. + [{check: $n, status: $s, detail: $d}]' <<<"$report")"
}
# Run a check command; its last line of output is the detail.
run() {
  local name="$1" out
  shift
  if out="$("$@" 2>&1)"; then
    note "$name" ok "$(tail -n 1 <<<"$out")"
  else
    note "$name" fail "$(tail -n 3 <<<"$out" | tr '\n' ' ')"
  fi
}

quick_check() {
  local result
  result="$(sqlite3 -readonly "$1" "pragma quick_check;" 2>&1)"
  [ "$result" = ok ] || { echo "$result"; return 1; }
  echo "quick_check ok"
}
invariants_hold() {
  local result
  result="$(python3 "$TEENY_ROOT/bin/lib/evals.py" invariants "$root/evals" "$brain")" || {
    jq -r '.missing[] | "\(.id): \(.file) no longer says /\(.pattern)/"' <<<"$result" 2>/dev/null || echo "$result"
    return 1
  }
  echo "every anchor holds"
}
# The core's teeny.* jobs are exactly what seeding would make them.
cron_in_step() {
  local plan
  plan="$("$TEENY_ROOT/bin/seed-cron" --dry-run 2>&1)" || { echo "$plan"; return 1; }
  if ! grep -q "dry run: 0 change" <<<"$plan"; then
    grep -E "^\[seed-cron\] (add|update|replace|remove)" <<<"$plan" | head -3
    return 1
  fi
  echo "the core runs exactly brain/cron.toml"
}
# Every enabled job's next run is ahead, or only just behind: one far behind is
# a job the scheduler has stopped running. On 2026-11-11 three jobs sat at a
# next_run from before a reboot for 75 minutes and nothing said so
# (bin/seed-cron re-arms such a job at boot; bin/health watches between).
STALE_NEXT_RUN_MINUTES=10
cron_current() {
  local listed late
  listed="$(oh cron_list)" || return 1
  late="$(jq -r --argjson limit "$((STALE_NEXT_RUN_MINUTES * 60))" '
    def epoch: try (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch null;
    [ .[] | select(.enabled != false and .next_run != null)
      | (.next_run | epoch) as $t | select($t != null and $t < now - $limit)
      | "\(.name // .id) (next_run \(.next_run), \((now - $t) / 60 | floor) min ago)" ] | join(", ")' <<<"$listed")" ||
    return 1
  if [ -n "$late" ]; then
    echo "stuck: $late"
    return 1
  fi
  echo "no enabled job is more than $STALE_NEXT_RUN_MINUTES minutes behind"
}
# A cron agent turn (the builder, the operator) gets the budget bin/spine sets,
# not the core's default 120 s, which ended every build before its tests.
agent_turn_budget() {
  local secs
  secs="$(oh config_get_agent_settings | jq -r '.agent_timeout_secs // .result.agent_timeout_secs // empty')" || return 1
  if ! [[ "$secs" =~ ^[0-9]+$ ]] || [ "$secs" -lt "$TEENY_AGENT_TURN_SECS" ]; then
    echo "agent_timeout_secs is ${secs:-unset}, under ${TEENY_AGENT_TURN_SECS}s: a cron agent turn stops before it finishes (bin/spine sets it at boot)"
    return 1
  fi
  echo "${secs}s"
}

# The browser loads and Chrome starts: the core's readiness probe loads
# TinyComputer and opens and closes one disposable, non-navigating Chrome
# session. On 2026-11-13 every browser call failed with "module
# 'tinycomputer' callback source cannot preserve admitted identity" and only
# the operator's report said so.
browser_ready() {
  local answer
  answer="$(OH_TIMEOUT=60 oh modules_browser_check_readiness)" || return 1
  if ! jq -e '.module_ready == true and .chrome_ready == true' <<<"$answer" >/dev/null; then
    jq -r '"module_ready=\(.module_ready) chrome_ready=\(.chrome_ready): \(.error // "no reason given")"' <<<"$answer"
    return 1
  fi
  echo "TinyComputer serving, Chrome starts"
}

# Every model the studio is set to answers one small turn on the route the
# studio asks it on: the writer's and editor's through bin/ask (a tool-less
# agent turn, the editor's prompt, which is the smaller), the judges' through
# the simple chat. On 2026-11-19 a studio preview on claude-fable-5.2 and
# claude-opus-5.5 had every first turn refused, "HTTP 400 (request_rejected):
# messages: at least one message is required" (the core had no window for
# them and the trim dropped the message), the run fell back to the core's
# default model, and only the spine's log said so. Skipped when no studio
# model is set (the core's default answers the heartbeat); one turn a model,
# DOCTOR_MODEL_TURNS=0 skips it. bin/ask registers a model's window with the
# core first when it has none: the one write this check can make.
studio_models_answer() {
  local listed route model out status failed_models="" n=0
  local probe='Answer with the JSON {"ok": true} and nothing else.'
  listed="$(TEENY_SECRETS="$secrets" python3 "$TEENY_ROOT/bin/lib/studio_switch.py" models 2>&1)" || {
    echo "the studio's models cannot be read: $listed"
    return 1
  }
  [ -n "$listed" ] || { echo "no studio model set: its turns run on the core's default"; return 0; }
  while read -r route model; do
    [ -n "$model" ] || continue
    n=$((n + 1))
    status=0
    if [ "$route" = agent ]; then
      out="$(OH_TIMEOUT=120 timeout --kill-after=5 130 "$TEENY_ROOT/bin/ask" --agent editor --model "$model" "$probe" 2>&1)" ||
        status=$?
    else
      out="$(OH_TIMEOUT=120 oh inference_agent_chat_simple \
        "$(jq -cn --arg m "$probe" --arg o "$model" '{message: $m, model_override: $o}')" 2>&1)" || status=$?
    fi
    if [ "$status" -ne 0 ] || ! [[ "$out" =~ [^[:space:]] ]]; then
      failed_models="$failed_models; $model ($route): $(tail -n 1 <<<"${out:-no answer}" | cut -c1-200)"
    fi
  done <<<"$listed"
  if [ -n "$failed_models" ]; then
    echo "refused a turn:${failed_models#;}"
    return 1
  fi
  echo "$n model turn(s) answered: $(awk '{print $2 " (" $1 ")"}' <<<"$listed" | paste -sd, - | sed 's/,/, /g')"
}

# --- the brain -----------------------------------------------------------------
# CHARTER.md is the charter's short version (docs/governance.md): frozen, and
# in every speaking prompt.
for file in SOUL.md DRIVE.md CHARTER.md CONTEXT.md; do
  if [ -s "$brain/$file" ]; then
    note "brain/$file" ok "$(wc -l <"$brain/$file" | tr -d ' ') lines"
  else
    note "brain/$file" fail "missing or empty"
  fi
done
if [ -e "$brain/config.toml" ]; then
  note "brain/config.toml" fail "must not exist: the core would nest a second workspace in the brain"
fi

# --- cron: the rules, and every playbook a job runs -------------------------------
checked=" "
# Not --strict: a catch-up a playbook edit made unsafe is switched off at
# boot (a warning here), never a reason to refuse the checkout.
policy_err="$(mktemp)"
if jobs="$(python3 "$TEENY_ROOT/bin/lib/cron_policy.py" "$brain/cron.toml" "$root/evals/cron.pinned.toml" "${CALENDAR_TZ:-}" 2>"$policy_err")"; then
  note "cron.toml" ok "$(jq length <<<"$jobs") job(s), $(jq '[.[] | select(.enabled)] | length' <<<"$jobs") enabled"
  if [ -s "$policy_err" ]; then
    note "cron catch-up" warn "$(tr '\n' ' ' <"$policy_err")"
  fi
  while IFS= read -r book; do
    checked+=" $book "
    run "playbook $book" env TEENY_BRAIN="$brain" OPENHUMAN_WORKSPACE="$brain" TEENY_ROOT="$root" \
      TEENY_HANDS="$root/hands" "$TEENY_ROOT/bin/act" --check "$book"
  # A studio slot's --legacy playbook is what the slot runs with STUDIO=0
  # (the rollback): it is checked like any scheduled one.
  done < <(jq -r '.[] | (.command // "") | if startswith("bin/act ") then ltrimstr("bin/act ")
    elif startswith("bin/studio ") then (split(" ") as $a | ($a | index("--legacy")) as $i
      | if $i == null then empty else $a[$i + 1] end)
    else empty end' <<<"$jobs" | sort -u)
else
  note "cron.toml" fail "$(cat "$policy_err")"
fi
rm -f "$policy_err"
# A playbook nothing schedules yet still has to parse: the next cron may name it.
for path in "$brain"/playbooks/*.md; do
  [ -e "$path" ] || continue
  book="$(basename "$path" .md)"
  case "$checked" in *" $book "*) continue ;; esac
  run "playbook $book" python3 "$TEENY_ROOT/bin/lib/playbook.py" "$brain" "$book" "$root/hands"
done

# --- agents: each definition parses; the drafting agents have no tools, and only
# the scheduled agents (builder, operator) act from cron, with named tools -----
for path in "$brain"/agents/*.toml; do
  [ -e "$path" ] || continue
  run "agent $(basename "$path")" python3 "$TEENY_ROOT/bin/lib/agent_check.py" "$path"
done
if [ ! -s "$brain/agents/act.toml" ]; then
  note "agent act.toml" fail "missing: bin/act drafts with it"
fi
# The studio switch: STUDIO must read as on or off (anything else posts
# nothing on either path), and with it on the judges must not be the writer.
studio_check="$(TEENY_SECRETS="$secrets" python3 "$TEENY_ROOT/bin/lib/studio_switch.py" doctor 2>&1)" ||
  studio_check="fail $studio_check"
note "studio switch" "${studio_check%% *}" "${studio_check#* }"
for agent in writer editor; do
  [ -s "$brain/agents/$agent.toml" ] || note "agent $agent.toml" fail "missing: bin/studio drafts and picks with it"
done
if [ ! -s "$brain/agents/judge.toml" ]; then
  note "agent judge.toml" fail "missing: bin/eval judges with it"
fi
if [ ! -s "$brain/agents/querier.toml" ]; then
  note "agent querier.toml" fail "missing: bin/evolve writes its search queries with it"
fi

# --- the two reviewed lists: http_request's allowed hosts, the browser's denied ones -
run "browser-allow.txt" python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from pathlib import Path
from teeny_hands import websites
hosts = websites.load(Path(sys.argv[2]))
print(f"{len(hosts)} host(s)")
' "$root/hands/lib" "$root"
# The browser opens the public web; without its deny list it would have no
# fence at all, so a missing or broken list fails the boot.
run "browser-deny.txt" python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from pathlib import Path
from teeny_hands import websites
hosts = websites.load_deny(Path(sys.argv[2]))
print(f"{len(hosts)} host(s) the browser never opens")
' "$root/hands/lib" "$root"

# --- invariants: the brain still says what Teeny is (evals/invariants.md) ----------
if [ -s "$root/evals/invariants.md" ]; then
  run "invariants" invariants_hold
else
  note "invariants" fail "no evals/invariants.md in $root"
fi

# --- the autonomy ladder: no switch set above its level (docs/governance.md) ------
# A switch in secrets/ that is on while its capability's granted level in
# evals/autonomy.toml is under what it needs fails: "merge" at L4 refuses
# EVOLVE_AUTO_PROMOTE=1. One that only a drop (a promotion, a model change)
# put under its level warns: failing the boot there would take Teeny down at
# the moment it restarts on a promotion or a fallback model.
# First the model behind each role (G8): a change from the last one recorded
# (secrets/autonomy/models.jsonl, out of every agent's reach) drops the levels
# that run on it and prepares the issue `bin/autonomy issue` opens.
if [ -s "$root/evals/autonomy.toml" ]; then
  models="$(python3 "$TEENY_ROOT/bin/lib/autonomy.py" models --root "$root" --secrets "$secrets" --state "$state" 2>&1)" || true
  if jq -e '.changes | length > 0' <<<"$models" >/dev/null 2>&1; then
    note "model" warn "changed: $(jq -r .detail <<<"$models"); the levels on it dropped, rerun the fence tests (bin/autonomy issue)"
  elif jq -e '.recorded != null' <<<"$models" >/dev/null 2>&1; then
    note "model" ok "$(jq -r .detail <<<"$models")"
  else
    note "model" warn "could not record the model behind each role: $(tail -n 1 <<<"$models")"
  fi
  ladder="$(python3 "$TEENY_ROOT/bin/lib/autonomy.py" check --root "$root" --secrets "$secrets" --state "$state" 2>&1)" || true
  status="$(jq -r '.status // "fail"' <<<"$ladder" 2>/dev/null || echo fail)"
  detail="$(jq -r '.detail // empty' <<<"$ladder" 2>/dev/null || true)"
  note "autonomy ladder" "$status" "${detail:-$ladder}"
else
  note "autonomy ladder" fail "no evals/autonomy.toml in $root"
fi

# --- the guard: its lexical screen still holds what it must ----------------------
# The screen, not `hands/guard check`: check files a hold and asks the model
# judge, and a doctor writes nothing.
if [ -d "$root/hands/lib/teeny_hands/guard" ]; then
  run "guard screen" python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from teeny_hands.guard.screen import screen_text
held = screen_text("kill yourself", "outbound")
if held is None:
    sys.exit("the screen let a self-harm phrase through")
if screen_text("gm tiny humans, coffee loading", "outbound") is not None:
    sys.exit("the screen held a plain gm")
print(f"holds {held.category}, passes a gm")
' "$root/hands/lib"
else
  note "guard screen" fail "no hands/guard in $root: nothing could be published"
fi

# --- the X profile says what it is (docs/roadmap.md, P1) ------------------------
# The bio must say the account is automated and name the operator
# (X_OPERATOR_HANDLE). Read from the profile bin/stats-snapshot keeps in
# state/hands.db, never from X: a boot makes no call. A warning, never a
# failure: the bio is the operator's to fix on X.
if [ -f "$root/hands/lib/teeny_hands/x/profile.py" ]; then
  if profile_out="$(python3 -I -c '
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from teeny_hands import hand
from teeny_hands.x import profile
env = Path(sys.argv[3])
settings = hand._parse_env_file(env.read_text()) if env.is_file() else {}
status, detail = profile.check(Path(sys.argv[2]), settings)
print(status, detail)
' "$root/hands/lib" "$state/hands.db" "$secrets/teeny.env" 2>&1)"; then
    note "x profile" "${profile_out%% *}" "${profile_out#* }"
  else
    note "x profile" warn "the check could not run: $(tail -n 1 <<<"$profile_out")"
  fi
fi

# --- the wallet: no wallet keys without sane caps ---------------------------------
# Once any WALLET_* key is set, every cap must be set, above zero and under its
# ceiling (hands/lib/teeny_hands/wallet/caps.py): a wallet never boots uncapped.
run "wallet caps" python3 "$TEENY_ROOT/bin/lib/wallet_config.py" --check "$secrets/teeny.env"

# --- the x402 hand: its top-up and search limits are sane -------------------------
# X402_FUND_* (the pinned x402-fund job) and X402_*_MAX_USD, X402_TEXT_CHARS
# (paid search), checked by the hand's own code (teeny_hands/x402/settings.py):
# a top-up switched on without its floor, target and daily cap, or any value
# over its ceiling, never boots.
run "x402 settings" python3 -I -c '
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from teeny_hands.hand import _parse_env_file
from teeny_hands.x402 import settings
env = Path(sys.argv[2])
try:
    print(settings.check(_parse_env_file(env.read_text()) if env.is_file() else {}))
except settings.SettingsError as exc:
    sys.exit(f"x402 keys are set but not usable: {exc}")
' "$root/hands/lib" "$secrets/teeny.env"

# --- the surplus hand: its sweep to the surplus wallet is sane ----------------------
# SURPLUS_* (the pinned surplus-sweep job), checked by the hand's own code
# (teeny_hands/surplus/settings.py): a sweep switched on without its address,
# any value over its ceiling, or a Base reserve under the x402 rail's target,
# never boots.
run "surplus settings" python3 -I -c '
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from teeny_hands.hand import _parse_env_file
from teeny_hands.surplus import settings
env = Path(sys.argv[2])
try:
    print(settings.check(_parse_env_file(env.read_text()) if env.is_file() else {}))
except settings.SettingsError as exc:
    sys.exit(f"surplus keys are set but not usable: {exc}")
' "$root/hands/lib" "$secrets/teeny.env"

# --- secrets and storage ------------------------------------------------------------
mode_of() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }
if [ -e "$storage" ]; then
  # A storage.db without its master key is unreadable: never boot one
  # without the other.
  if [ -s "$secrets/openhuman.key" ]; then
    note "secrets/openhuman.key" ok "present, mode $(mode_of "$secrets/openhuman.key")"
  else
    note "secrets/openhuman.key" fail "storage.db exists but its master key does not"
  fi
  if command -v sqlite3 >/dev/null 2>&1; then
    run "storage.db" quick_check "$storage"
  fi
else
  note "storage.db" ok "none yet (a first boot)"
fi
# Left over from the pre-spine layout (bin/kernel). Nothing reads them now,
# but a container still running the old entrypoint would keep writing there.
for leftover in "$secrets/kernel.env" "$root/workspace/storage.db"; do
  [ -e "$leftover" ] || continue
  note "${leftover#"$root"/}" warn "pre-spine leftover; the spine uses secrets/spine.env and brain/storage.db"
done
for file in core.token openhuman.key; do
  [ -e "$secrets/$file" ] || continue
  mode="$(mode_of "$secrets/$file")"
  if [ "$mode" = 600 ] || [ "$mode" = 400 ]; then
    note "secrets/$file mode" ok "$mode"
  else
    note "secrets/$file mode" fail "$mode; must be 600"
  fi
done

# The core's file keyring lives in the brain and refuses a directory anybody
# but this user could change, all the way up from / (bin/lib/private_dirs.py).
# A group-writable checkout fails every secret write, which the agents only
# see as the model answering 401.
if [ -d "$brain" ]; then
  run "keyring path" python3 "$TEENY_ROOT/bin/lib/private_dirs.py" "$brain"
fi

# --- the box ---------------------------------------------------------------------
free_kb="$(df -Pk "$root" | awk 'NR == 2 {print $4}')"
if [ "${free_kb:-0}" -ge $((1024 * 1024)) ]; then
  note "disk" ok "$((free_kb / 1024)) MB free"
else
  note "disk" fail "$((free_kb / 1024)) MB free; needs 1 GB"
fi

# git commits as Teeny, sealed off from the box's config (hands/git): the
# receipts and every push depend on it.
if [ -x "$root/hands/git" ]; then
  run "git" "$root/hands/git" check
fi

# The hand-test sandbox bin/evolve runs a candidate's hand tests in
# (bin/lib/sandbox.py): bubblewrap here, or the `sandbox` compose service. A
# warning, not a failure: without one a change to hand code is sent back,
# never shipped, and everything else still works.
if sandbox="$(python3 "$TEENY_ROOT/bin/lib/sandbox.py" status "$state/sandbox" 2>&1)"; then
  note "hand-test sandbox" ok "$sandbox"
else
  note "hand-test sandbox" warn "$(tail -n 1 <<<"$sandbox")"
fi

# The meme service (deploy/compose.yaml, `memegen`; hands/meme template): only
# when STUDIO_FORMATS in secrets/teeny.env names meme (on the box the file
# decides: cron and compose pass none). A boot makes no call: MEMEGEN_URL is read,
# and --live asks the service for its templates. A warning, never a failure,
# like the sandbox's: with it down a meme pitch makes no picture and is no
# post, and every other format still goes out.
if [ -f "$root/hands/lib/teeny_hands/meme/templates.py" ]; then
  meme_out="$(python3 -I -c '
import json, sys, urllib.parse, urllib.request
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from teeny_hands.hand import _parse_env_file
from teeny_hands.meme import templates
env = Path(sys.argv[2])
filed = _parse_env_file(env.read_text()) if env.is_file() else {}
formats = filed.get("STUDIO_FORMATS") or "post,thread,image"
if "meme" not in [f.strip() for f in formats.split(",")]:
    print("ok off: STUDIO_FORMATS names no meme, so nothing needs the memegen service")
    sys.exit()
url = (filed.get("MEMEGEN_URL") or templates.DEFAULT_URL).rstrip("/")
parts = urllib.parse.urlsplit(url)
if parts.scheme not in ("http", "https") or not parts.hostname:
    print(f"warn MEMEGEN_URL is not an http address ({url!r}): meme pitches make no picture")
    sys.exit()
if sys.argv[3] != "1":
    print(f"ok on, at {url} (bin/doctor --live asks it for its templates)")
    sys.exit()
up = "docker compose -f deploy/compose.yaml --profile memegen up -d memegen"
try:
    with urllib.request.urlopen(url + "/templates/", timeout=5) as answer:
        listed = json.loads(answer.read(templates.MAX_LISTING_BYTES))
    if not isinstance(listed, list) or not listed:
        raise ValueError("no templates")
except Exception as exc:  # noqa: BLE001 - any failure is the same warning
    print(f"warn no templates from {url} ({type(exc).__name__}): meme pitches make no picture until it is up ({up})")
    sys.exit()
print(f"ok {len(listed)} templates at {url}")
' "$root/hands/lib" "$secrets/teeny.env" "$live" 2>&1)" || meme_out="warn the check could not run: $(tail -n 1 <<<"$meme_out")"
  note "meme service" "${meme_out%% *}" "${meme_out#* }"
fi

# hands/trend's reader, digg-pp-cli (the Dockerfile's `digg` stage): where
# the studio reads what AI X is talking about. TREND_DIGG_BIN in
# secrets/teeny.env names another. In the image (OPENHUMAN_DOCKER=1) one
# missing is a broken build and fails; outside it (a laptop, CI) it warns:
# the studio still runs, on Hacker News alone.
digg_bin=""
[ ! -f "$secrets/teeny.env" ] || digg_bin="$(sed -n 's/^TREND_DIGG_BIN=//p' "$secrets/teeny.env" | tail -n 1)"
[ -n "$digg_bin" ] || digg_bin="$(command -v digg-pp-cli 2>/dev/null || true)"
if [ -n "$digg_bin" ] && [ -x "$digg_bin" ] && digg_says="$(HOME="$state/trend/home" timeout 10 "$digg_bin" version 2>&1)"; then
  note "trend reader" ok "$(tail -n 1 <<<"$digg_says")"
elif [ "${OPENHUMAN_DOCKER:-}" = 1 ]; then
  note "trend reader" fail "digg-pp-cli is not in the image (${digg_bin:-not on PATH}): rebuild the spine image"
else
  note "trend reader" warn "digg-pp-cli is not installed (${digg_bin:-not on PATH}): the studio reads Hacker News alone"
fi

# --- optional: the hands' tests --------------------------------------------------------
if [ "$full" = 1 ]; then
  run "hands tests" python3 -m unittest discover -s "$root/hands/tests" -t "$root/hands/tests"
fi

# --- optional: the running core ------------------------------------------------------
if [ "$live" = 1 ]; then
  if curl -fsS -m 5 -o /dev/null "$OH_URL/health" 2>/dev/null; then
    note "core /health" ok "$OH_URL"
    run "cron in step" cron_in_step
    run "cron next runs are current" cron_current
    run "cron agent turn budget" agent_turn_budget
    run "browser" browser_ready
    if [ "${DOCTOR_MODEL_TURNS:-1}" != 0 ]; then
      run "studio models answer" studio_models_answer
    fi
  else
    note "core /health" fail "no answer at $OH_URL"
  fi
  if jq -e '.[] | select(.name == "teeny.heartbeat" and .enabled)' <<<"${jobs:-[]}" >/dev/null 2>&1; then
    beat="$(cat "$state/heartbeat" 2>/dev/null || true)"
    age="$(python3 -c '
import sys, datetime
try:
    t = datetime.datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    print(int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() // 60))
except ValueError:
    print(-1)
' "$beat")"
    if [ "$age" -ge 0 ] && [ "$age" -le 15 ]; then
      note "heartbeat" ok "$age min ago"
    else
      note "heartbeat" fail "last beat ${beat:-never}"
    fi
  fi
fi

commit="$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)"
# The report goes in on stdin, never as an argument: every playbook's check
# carries the playbook, and past 128 KiB one argument is refused by the kernel
# ("Argument list too long"), which left no state/doctor.json at all.
out="$(printf '%s' "$report" | jq -c --arg commit "$commit" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson live "$live" --argjson failed "$failed" \
  '{ok: ($failed == 0), at: $at, commit: $commit, live: ($live == 1), failed: $failed, checks: .}')"
mkdir -p "$state"
printf '%s\n' "$out" >"$state/doctor.json.tmp" && mv "$state/doctor.json.tmp" "$state/doctor.json"
printf '%s\n' "$out"
[ "$failed" = 0 ]
