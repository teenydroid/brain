#!/usr/bin/env bash
# The backroom: two of Teeny's minds riff on an idea with nobody watching,
# and a third finishes the best of it. Ideas in, output out.
#
#   bin/backroom [--format video|clip|post|thread|meme] [--turns N] [--out DIR] IDEA...
#   echo IDEA | bin/backroom
#
# The logic, the models and where rooms are kept: bin/lib/backroom.py. The
# agents' prompts: brain/narrative/BACKROOM.md. Nothing here posts.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need python3
exec python3 "$TEENY_ROOT/bin/lib/backroom.py" "$@"
