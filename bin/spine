#!/usr/bin/env bash
# Run the OpenHuman core over this checkout: the container's entrypoint, and
# how to run the spine on a laptop.
#
#   bin/spine
#
# 1. Mints what a first boot needs and nothing else: secrets/core.token (the
#    RPC bearer) and secrets/openhuman.key (the master key every secret the core
#    stores is encrypted under). Back both up with brain/storage.db; a
#    storage.db without its key is unreadable.
# 2. Runs bin/doctor, and refuses to boot a checkout it fails.
# 3. Starts `openhuman-core serve` with the brain, the single storage file
#    and the file keyring (docs/architecture.md, "Spine"), with the inbound
#    sources (bin/lib/inbound_config.py) and Teeny's core settings
#    (bin/lib/core_config.py: cron, autonomy, browser, modules) written into
#    its config.
# 4. Once it answers, points it at the model and the memory store named in
#    secrets/spine.env, then makes cron match brain/cron.toml.
# 5. Waits on the core, forwarding SIGTERM, and exits with its status.
#
# secrets/spine.env is read in a subshell and never exported to the core:
# shell jobs inherit the core's environment, and the model and memory keys
# belong in the core's encrypted store, not in every job's `env`.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need curl jq python3 sqlite3

# The image sets OPENHUMAN_CORE_BIN; on a laptop it is the release build in
# this checkout (`cargo build --release -p teeny-spine`).
core_bin="${OPENHUMAN_CORE_BIN:-}"
if [ -z "$core_bin" ]; then
  core_bin="$TEENY_ROOT/target/release/teeny-spine"
  [ -x "$core_bin" ] || core_bin=teeny-spine
fi
command -v "$core_bin" >/dev/null 2>&1 || die "no spine binary at '$core_bin' (cargo build --release -p teeny-spine, or set OPENHUMAN_CORE_BIN)"
host="${OPENHUMAN_CORE_HOST:-127.0.0.1}"
port="${OPENHUMAN_CORE_PORT:-7788}"

mkdir -p "$TEENY_BRAIN" "$TEENY_STATE"
(umask 077 && mkdir -p "$TEENY_SECRETS")
# The core's file keyring (in the brain) refuses a directory others can write,
# and a clone under umask 002 leaves the checkout and brain/ group-writable.
# Tighten what this user owns, from the brain up to the checkout; bin/doctor
# fails anything still wrong (a parent owned by someone else).
python3 "$TEENY_ROOT/bin/lib/private_dirs.py" --fix "$TEENY_BRAIN" "$(dirname "$TEENY_BRAIN")" >/dev/null || true
# Never a config.toml inside the brain: the core would take the brain
# for its home and nest a second workspace/ inside it.
[ ! -e "$TEENY_BRAIN/config.toml" ] ||
  die "$TEENY_BRAIN/config.toml must not exist; the core keeps its config in $(dirname "$TEENY_BRAIN")/.openhuman/"
# The core takes the sibling .openhuman/ for its config only when the folder is
# named `workspace` or that config already exists; for brain/ on a first boot
# it would nest brain/workspace/ and never read SOUL.md. An empty config is
# the core's defaults, and it fills the file in itself.
config_dir="$(dirname "$TEENY_BRAIN")/.openhuman"
if [ ! -e "$config_dir/config.toml" ]; then
  mkdir -p "$config_dir"
  : >"$config_dir/config.toml"
fi

# The mentions source: which agent drafts a batch of mentions, the debounce,
# and the prompt from brain/playbooks/mentions.md. The core only reads it at
# boot, so it is rewritten into the config every boot.
python3 "$TEENY_ROOT/bin/lib/inbound_config.py" "$config_dir/config.toml" "$TEENY_BRAIN" ||
  die "could not write the inbound sources into $config_dir/config.toml"
# The wallet's spend policy and Solana cluster, from secrets/teeny.env
# (bin/lib/wallet_config.py): its export lines are evaluated here.
wallet_env="$(python3 "$TEENY_ROOT/bin/lib/wallet_config.py" "$config_dir/config.toml" "$TEENY_SECRETS/teeny.env")" || die "could not write the wallet policy into $config_dir/config.toml"
eval "$wallet_env"

# Teeny's own core settings (bin/lib/core_sections/*.py): the cron shell
# timeout, the autonomy policy and the workbench the scheduled agents' file
# tools reach, the browser and its allowed websites (deploy/browser-allow.txt),
# and the linked modules. Read only at boot, so rewritten every boot.
python3 "$TEENY_ROOT/bin/lib/core_config.py" "$config_dir/config.toml" "$TEENY_ROOT" ||
  die "could not write Teeny's core settings into $config_dir/config.toml"
# The speaking agents' prompts: their instructions (brain/agents/<id>.md) and
# Teeny's world (CONTEXT.md, the lore it reads, the arcs), built into
# brain/agent/prompts/ where the core reads a prompt file (bin/lib/prompts.py).
python3 "$TEENY_ROOT/bin/lib/prompts.py" "$TEENY_BRAIN" >/dev/null ||
  die "could not build the agents' prompts into $TEENY_BRAIN/agent/prompts"
# It holds the model key in plain text ([secrets] in bin/lib/core_sections/secrets.py).
chmod 700 "$config_dir"
chmod 600 "$config_dir/config.toml"

mint() {
  local file="$1" what="$2"
  [ -s "$file" ] && return 0
  log "first boot: minting $what at $file"
  (umask 077 && python3 -c 'import secrets; print(secrets.token_hex(32))' >"$file")
}
mint "$TEENY_SECRETS/core.token" "the core RPC token"
mint "$TEENY_SECRETS/openhuman.key" "the keyring master key"

# Read one value from secrets/spine.env without loading the rest of it into
# this shell (and so into the core's environment).
spine_env() {
  local file="$TEENY_SECRETS/spine.env"
  [ -r "$file" ] || return 0
  # shellcheck disable=SC1090
  (set -a && . "$file" && printf '%s' "${!1:-}")
}

# The model endpoint is the one non-secret the core must have in its
# environment: a key-less core reaches an OpenAI-compatible endpoint only as
# its `local-openai` runtime, and that runtime's URL is LOCAL_OPENAI_URL. A
# custom cloud provider would need a TinyHumans sign-in (every turn fails
# SESSION_EXPIRED without one).
ladder_url="$(spine_env LADDER_URL)"
if [ -n "$ladder_url" ]; then
  export LOCAL_OPENAI_URL="$ladder_url"
fi

export OPENHUMAN_WORKSPACE="$TEENY_BRAIN"
export OPENHUMAN_STORAGE_URL="sqlite:$TEENY_STORAGE"
export OPENHUMAN_ACTION_DIR="$TEENY_ROOT"
export OPENHUMAN_KEYRING_BACKEND=file
export OPENHUMAN_KEYRING_MASTER_KEY_FILE="$TEENY_SECRETS/openhuman.key"
OPENHUMAN_CORE_TOKEN="$(tr -d '[:space:]' <"$TEENY_SECRETS/core.token")"
export OPENHUMAN_CORE_TOKEN
export OPENHUMAN_CORE_HOST="$host" OPENHUMAN_CORE_PORT="$port"
export OPENHUMAN_CORE_URL="http://127.0.0.1:$port"
# For cron shell jobs, which do not inherit this environment (bin/lib/teeny.sh).
printf '%s\n' "$OPENHUMAN_CORE_URL" >"$TEENY_STATE/core.url"

# Teeny edits its own brain, so every boot starts with the doctor: a brain it
# would not boot safely (a broken cron.toml, a playbook that does not parse, a
# storage.db without its key, a guard that lets things through) never serves.
"$TEENY_ROOT/bin/doctor" >/dev/null || die "bin/doctor failed (state/doctor.json); not booting this checkout"

log "serving $TEENY_BRAIN on $host:$port (storage $TEENY_STORAGE)"
"$core_bin" serve &
core=$!
trap 'kill -TERM "$core" 2>/dev/null || true' TERM INT

for _ in $(seq 1 "${SPINE_BOOT_SECS:-120}"); do
  curl -fsS -o /dev/null "$OPENHUMAN_CORE_URL/health" 2>/dev/null && break
  kill -0 "$core" 2>/dev/null || { wait "$core" || exit $?; exit 1; }
  sleep 1
done
curl -fsS -o /dev/null "$OPENHUMAN_CORE_URL/health" || die "the core did not answer /health in ${SPINE_BOOT_SECS:-120}s"

# The model and the memory store, from secrets/spine.env when it exists. Set
# on every boot, so editing the file and restarting is the whole procedure.
(
  env_file="$TEENY_SECRETS/spine.env"
  if [ -r "$env_file" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi
  if [ -n "${LADDER_URL:-}" ]; then
    [ -n "${SPINE_MODEL:-}" ] || die "LADDER_URL is set without SPINE_MODEL (the model id every workload uses, as LLM_MODEL is today)"
    # The key goes to the core's config, never its environment. Once stored it
    # can be dropped from spine.env: a boot without it keeps the stored one.
    # Every call here ends in `|| die`: this block runs in a subshell whose
    # status is tested, and bash ignores set -e inside one, so a failed call
    # would otherwise fall through to "ready" and every turn would 401.
    oh config_update_local_ai_settings "$(jq -cn --arg k "${LADDER_API_KEY:-}" \
      '{runtime_enabled: true, opt_in_confirmed: true} + (if $k != "" then {api_key: $k} else {} end)')" >/dev/null ||
      die "model: the core did not store the model settings (the key above); every turn would fail"
    [ -n "${LADDER_API_KEY:-}" ] || log "model: no LADDER_API_KEY; keeping the key the core already stores"
    oh config_update_model_settings "$(jq -cn --arg m "$SPINE_MODEL" '("local-openai:" + $m) as $p |
      {default_model: $m, chat_provider: $p, reasoning_provider: $p, agentic_provider: $p,
       coding_provider: $p, vision_provider: $p, memory_provider: $p}')" >/dev/null ||
      die "model: the core did not take $SPINE_MODEL as its model"
    log "model: $LADDER_URL as local-openai:$SPINE_MODEL"
    # The core never asks a local-openai endpoint for the model's window and
    # budgets an unknown one at a few thousand tokens: less than its own
    # system prompt, so the trim drops the user's message and the model
    # answers an empty turn. SPINE_CONTEXT_WINDOW wins; else the endpoint's
    # own listing (the ladder reports `context_length`). The key goes in a
    # header file, never in curl's argv.
    window="${SPINE_CONTEXT_WINDOW:-}"
    if [ -z "$window" ]; then
      window="$(curl -fsS -m 10 -H @<(printf 'authorization: Bearer %s\n' "${LADDER_API_KEY:-}") \
        "${LADDER_URL%/}/models" 2>/dev/null | jq -r --arg m "$SPINE_MODEL" \
        '[.data[]? | select(.id == $m or ((.aliases // []) | index($m)))
          | (.context_length // .context_window // empty)][0] // empty' 2>/dev/null)" || window=""
    fi
    if [[ "$window" =~ ^[1-9][0-9]*$ ]]; then
      oh inference_update_model_settings "$(jq -cn --arg m "$SPINE_MODEL" --argjson w "$window" \
        '{model_registry: [{id: $m, provider: "local-openai", context_window: $w}]}')" >/dev/null ||
        die "model: the core did not take the $window-token window"
      log "model: $SPINE_MODEL has a $window-token window"
    else
      log "model: no window for $SPINE_MODEL from the endpoint; keeping the stored one (set SPINE_CONTEXT_WINDOW if turns come back empty)"
    fi
  else
    log "model: not configured (no LADDER_URL in $env_file)"
  fi
  if [ -n "${CORTEX_API_URL:-}" ]; then
    result="$(oh memory_engine_set "$(jq -cn --arg u "$CORTEX_API_URL" --arg k "${CORTEX_API_KEY:-}" \
      '{engine: "cortexdb", endpoint: $u} + (if $k != "" then {api_key: $k} else {} end)')")" ||
      die "memory: the core did not take cortexdb at $CORTEX_API_URL"
    status="$(jq -r '.status // "unknown"' <<<"$result")"
    log "memory: cortexdb at $CORTEX_API_URL ($status)"
  else
    log "memory: not configured (no CORTEX_API_URL in $env_file)"
  fi
) || { kill -TERM "$core"; wait "$core" || true; die "configuring the core failed"; }

"$TEENY_ROOT/bin/seed-cron" || { kill -TERM "$core"; wait "$core" || true; die "seeding cron failed"; }
log "ready"

# A trapped signal interrupts `wait` before the core has finished shutting
# down; keep waiting until it is actually gone.
status=0
while :; do
  if wait "$core"; then status=0; else status=$?; fi
  kill -0 "$core" 2>/dev/null || break
done
log "the core exited with status $status"
exit "$status"
