#!/usr/bin/env bash
# Run the core over this checkout: the container's entrypoint, and how to run
# the spine on a laptop. The core is core/ (TypeScript): it answers the RPC the
# hands and scripts call and supervises an OpenClaw Gateway, which runs the
# agents' turns (docs/architecture.md, "The OpenClaw Gateway").
#
#   bin/spine
#
# 1. Mints what a first boot needs and nothing else: secrets/core.token (the
#    RPC bearer) and secrets/openhuman.key (the master key every secret the core
#    stores is encrypted under). Back both up with brain/storage.db; a
#    storage.db without its key is unreadable.
# 2. Runs bin/doctor, and refuses to boot a checkout it fails.
# 3. Starts `bin/teeny-core serve` with the brain, the single storage file
#    and the master key file (docs/architecture.md, "Spine"), with the inbound
#    sources (bin/lib/inbound_config.py) and Teeny's core settings
#    (bin/lib/core_config.py: the cron shell timeout, the wallet policy)
#    written into its config.toml, which the core reads (TEENY_CORE_CONFIG).
#    The core writes the Gateway's config to state/openclaw/ and starts it.
# 4. Once it answers, points it at the model and the memory store named in
#    secrets/spine.env, checks the Gateway's config it wrote (the lockdown
#    flags, `openclaw security audit`), then makes cron match brain/cron.toml.
# 5. Waits on the core, forwarding SIGTERM, and exits with its status.
#
# Its pid is in state/spine.pid: a promotion (bin/evolve) restarts the core by
# sending it TERM, and compose starts it again on the new checkout.
#
# The last-good boot: when the doctor or the boot fails and state/last-good
# names another commit (bin/evolve writes it just before it restarts on a
# promotion), it checks that commit out, detached, and boots again, once
# (bin/lib/last_good.py). Without state/last-good it fails as before.
#
# A lab spine (SPINE_LAB=1, started by bin/evolve over a candidate's worktree,
# bin/lib/lab.py) refuses to run unless DRY_RUN=1, seeds no cron and never
# falls back. SPINE_LAB_EDIT=1 lets its agents' file tools write the worktree
# (bin/lib/core_sections/automation.py), for the evolver.
#
# secrets/spine.env is read in a subshell and never exported to the core:
# shell jobs inherit the core's environment, and the model and memory keys
# belong in the core's encrypted store, not in every job's `env`.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
# shellcheck source=bin/lib/model_windows.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/model_windows.sh"
# shellcheck source=bin/lib/boot_cron.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/boot_cron.sh"
need curl jq python3 sqlite3

lab="${SPINE_LAB:-0}"
if [ "$lab" = 1 ] && [ "${DRY_RUN:-}" != 1 ]; then
  die "a lab spine (SPINE_LAB=1) runs only with DRY_RUN=1"
fi

# The image sets OPENHUMAN_CORE_BIN to /usr/local/bin/teeny-core; on a laptop
# it is bin/teeny-core, which runs the build in this checkout
# (`cd core && npm ci && npm run build`). Both exec Node 24 on core/dist/main.js.
core_bin="${OPENHUMAN_CORE_BIN:-$TEENY_ROOT/bin/teeny-core}"
command -v "$core_bin" >/dev/null 2>&1 || die "no core at '$core_bin' (bin/teeny-core, or set OPENHUMAN_CORE_BIN)"
host="${OPENHUMAN_CORE_HOST:-127.0.0.1}"
port="${OPENHUMAN_CORE_PORT:-7788}"

mkdir -p "$TEENY_BRAIN" "$TEENY_STATE"
(umask 077 && mkdir -p "$TEENY_SECRETS")
printf '%s\n' "$$" >"$TEENY_STATE/spine.pid"

# Boot state/last-good instead of this checkout, once, when there is one
# (bin/lib/last_good.py says when there is not). Returns only when it cannot.
fall_back() {
  [ "${SPINE_LAST_GOOD_TRIED:-0}" = 1 ] && return 1
  python3 "$TEENY_ROOT/bin/lib/last_good.py" fallback "$TEENY_ROOT" "$TEENY_STATE" "$1" || return 1
  log "$1; booting state/last-good instead"
  exec env SPINE_LAST_GOOD_TRIED=1 "$TEENY_ROOT/bin/spine"
}
# The boot failed after the core started: stop it, then try last-good.
boot_failed() {
  kill -TERM "$core" 2>/dev/null || true
  wait "$core" 2>/dev/null || true
  fall_back "$1" || die "$1"
}
# The core's file keyring (in the brain) refuses a directory others can write,
# and a clone under umask 002 leaves the checkout and brain/ group-writable.
# Tighten what this user owns, from the brain up to the checkout; bin/doctor
# fails anything still wrong (a parent owned by someone else).
python3 "$TEENY_ROOT/bin/lib/private_dirs.py" --fix "$TEENY_BRAIN" "$(dirname "$TEENY_BRAIN")" >/dev/null || true
# state/ too: OpenClaw refuses to start when its state directory is group- or
# world-writable ("No safe OpenClaw temp root is available"), and a state/
# made under umask 002 is. That surfaced only after the "ready" line.
python3 "$TEENY_ROOT/bin/lib/private_dirs.py" --fix "$TEENY_STATE" >/dev/null || true
# And what is already under state/openclaw/ (the Gateway's state, which OpenClaw also checks as the temp
# root's ancestors: "Temp workspace ancestor ... is group/world writable"): directories made under umask 002
# by an earlier boot or a copy. Only directories this user owns; a failure is the doctor's to say, not a stop.
if [ -d "$TEENY_STATE/openclaw" ]; then
  find "$TEENY_STATE/openclaw" -type d -uid "$(id -u)" -perm /022 -exec chmod go-w {} + 2>/dev/null || true
fi
# Never a config.toml inside the brain: the core would take the brain
# for its home and nest a second workspace/ inside it.
[ ! -e "$TEENY_BRAIN/config.toml" ] ||
  die "$TEENY_BRAIN/config.toml must not exist; the core keeps its config in $(dirname "$TEENY_BRAIN")/.openhuman/"
# The core takes the sibling .openhuman/ for its config only when the folder is
# named `workspace` or that config already exists; for brain/ on a first boot
# it would nest brain/workspace/ and never read SOUL.md. An empty config is
# the core's defaults, and it fills the file in itself.
config_dir="$(dirname "$TEENY_BRAIN")/.openhuman"
if [ ! -e "$config_dir/config.toml" ]; then
  mkdir -p "$config_dir"
  : >"$config_dir/config.toml"
fi

# The mentions source: which agent drafts a batch of mentions, the debounce,
# and the prompt from brain/playbooks/mentions.md. The core only reads it at
# boot, so it is rewritten into the config every boot.
python3 "$TEENY_ROOT/bin/lib/inbound_config.py" "$config_dir/config.toml" "$TEENY_BRAIN" ||
  die "could not write the inbound sources into $config_dir/config.toml"
# The wallet's spend policy and Solana cluster, from secrets/teeny.env
# (bin/lib/wallet_config.py): its export lines are evaluated here.
wallet_env="$(python3 "$TEENY_ROOT/bin/lib/wallet_config.py" "$config_dir/config.toml" "$TEENY_SECRETS/teeny.env")" || die "could not write the wallet policy into $config_dir/config.toml"
eval "$wallet_env"

# Teeny's own core settings (bin/lib/core_sections/*.py): the cron shell
# timeout, the autonomy policy and the workbench the scheduled agents' file
# tools reach, the browser, http_request's allowed hosts (deploy/browser-allow.txt),
# and the linked modules. Read only at boot, so rewritten every boot.
python3 "$TEENY_ROOT/bin/lib/core_config.py" "$config_dir/config.toml" "$TEENY_ROOT" ||
  die "could not write Teeny's core settings into $config_dir/config.toml"
# The speaking agents' prompts: their instructions (brain/agents/<id>.md) and
# Teeny's world (MEMORY.md, CONTEXT.md, the lore it reads, the arcs), built
# into brain/agent/prompts/ where the core reads a prompt file
# (bin/lib/prompts.py). A checkout without the live MEMORY.md (gitignored)
# gets one started from brain/MEMORY.seed.md first.
python3 "$TEENY_ROOT/bin/lib/prompts.py" "$TEENY_BRAIN" >/dev/null ||
  die "could not build the agents' prompts into $TEENY_BRAIN/agent/prompts"
# It holds the model key in plain text ([secrets] in bin/lib/core_sections/secrets.py).
chmod 700 "$config_dir"
chmod 600 "$config_dir/config.toml"

mint() {
  local file="$1" what="$2"
  [ -s "$file" ] && return 0
  log "first boot: minting $what at $file"
  (umask 077 && python3 -c 'import secrets; print(secrets.token_hex(32))' >"$file")
}
mint "$TEENY_SECRETS/core.token" "the core RPC token"
mint "$TEENY_SECRETS/openhuman.key" "the keyring master key"

# Read one value from secrets/spine.env without loading the rest of it into
# this shell (and so into the core's environment).
spine_env() {
  local file="$TEENY_SECRETS/spine.env"
  [ -r "$file" ] || return 0
  # shellcheck disable=SC1090
  (set -a && . "$file" && printf '%s' "${!1:-}")
}

# The model endpoint is the one non-secret the core must have in its
# environment: a key-less core reaches an OpenAI-compatible endpoint only as
# its `local-openai` runtime, and that runtime's URL is LOCAL_OPENAI_URL. A
# custom cloud provider would need a TinyHumans sign-in (every turn fails
# SESSION_EXPIRED without one).
ladder_url="$(spine_env LADDER_URL)"
if [ -n "$ladder_url" ]; then
  export LOCAL_OPENAI_URL="$ladder_url"
fi

# Every Gateway turn traced to the private Langfuse (docs/architecture.md,
# "Traces"): TRACES_OTLP_URL is the otel-collector on the compose network
# (http://otel-collector:4318, with `--profile langfuse` up). Not a secret: the
# collector holds Langfuse's key. TRACES_CAPTURE=0 keeps prompts, replies and
# tool payloads off the spans. Unset, nothing is exported.
traces_url="$(spine_env TRACES_OTLP_URL)"
if [ -n "$traces_url" ]; then
  export TEENY_OTEL_URL="$traces_url"
  traces_capture="$(spine_env TRACES_CAPTURE)"
  [ -n "$traces_capture" ] && export TEENY_OTEL_CAPTURE="$traces_capture"
fi

export TEENY_CORE_CONFIG="$config_dir/config.toml"
export OPENHUMAN_WORKSPACE="$TEENY_BRAIN"
export OPENHUMAN_STORAGE_URL="sqlite:$TEENY_STORAGE"
export OPENHUMAN_ACTION_DIR="$TEENY_ROOT"
export OPENHUMAN_KEYRING_MASTER_KEY_FILE="$TEENY_SECRETS/openhuman.key"
# The browser may open any public https page; private and local addresses
# stay refused, and deploy/browser-deny.txt is what it never opens, on every
# connection the browser makes (clicks and redirects included), whatever
# allow-all says; a list it cannot be read refuses every page. These are the
# names the guardrails plugin and the hands read.
export OPENHUMAN_BROWSER_ALLOW_ALL=1
export OPENHUMAN_BROWSER_DENY_FILE="$TEENY_ROOT/deploy/browser-deny.txt"
# Where the browser's own pictures of the pages it reaches go; hands/tasks
# moves a task's into
# state/media/tasks/<id>/ for a post's `shots`. Unset, none are taken.
export TEENY_BROWSER_PICTURES="$TEENY_STATE/browser/screenshots"
mkdir -p "$TEENY_BROWSER_PICTURES"
OPENHUMAN_CORE_TOKEN="$(tr -d '[:space:]' <"$TEENY_SECRETS/core.token")"
export OPENHUMAN_CORE_TOKEN
export OPENHUMAN_CORE_HOST="$host" OPENHUMAN_CORE_PORT="$port"
export OPENHUMAN_CORE_URL="http://127.0.0.1:$port"
# For cron shell jobs, which do not inherit this environment (bin/lib/teeny.sh).
printf '%s\n' "$OPENHUMAN_CORE_URL" >"$TEENY_STATE/core.url"

# Teeny edits its own brain, so every boot starts with the doctor: a brain it
# would not boot safely (a broken cron.toml, a playbook that does not parse, a
# storage.db without its key, a guard that lets things through) never serves.
"$TEENY_ROOT/bin/doctor" >/dev/null ||
  fall_back "bin/doctor failed" ||
  die "bin/doctor failed (state/doctor.json); not booting this checkout"
# Every boot goes in state/boots.jsonl, which the weekly audit reads to count
# deploys and restarts (bin/audit; docs/roadmap.md, G6). Never stops a boot.
"$TEENY_ROOT/bin/audit" boot >/dev/null 2>&1 || log "could not record this boot for the audit"

log "serving $TEENY_BRAIN on $host:$port (storage $TEENY_STORAGE)"
"$core_bin" serve &
core=$!
trap 'kill -TERM "$core" 2>/dev/null || true' TERM INT

for _ in $(seq 1 "${SPINE_BOOT_SECS:-120}"); do
  curl -fsS -o /dev/null "$OPENHUMAN_CORE_URL/health" 2>/dev/null && break
  kill -0 "$core" 2>/dev/null || boot_failed "the core exited before it answered /health"
  sleep 1
done
curl -fsS -o /dev/null "$OPENHUMAN_CORE_URL/health" || boot_failed "the core did not answer /health in ${SPINE_BOOT_SECS:-120}s"

# The cron agent turn budget (bin/lib/teeny.sh), set over RPC. The core keeps
# it in its settings store and gives it to the Gateway as the agents' turn
# timeout.
oh config_update_agent_settings "$(jq -cn --argjson s "$TEENY_AGENT_TURN_SECS" '{agent_timeout_secs: $s}')" >/dev/null ||
  boot_failed "the core did not take a ${TEENY_AGENT_TURN_SECS}s agent turn budget; the mind and the operator would stop at 120s"
log "agent turns: ${TEENY_AGENT_TURN_SECS}s"

# The model and the memory store, from secrets/spine.env when it exists. Set
# on every boot, so editing the file and restarting is the whole procedure.
(
  env_file="$TEENY_SECRETS/spine.env"
  if [ -r "$env_file" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi
  if [ -n "${LADDER_URL:-}" ]; then
    [ -n "${SPINE_MODEL:-}" ] || die "LADDER_URL is set without SPINE_MODEL (the model id every workload uses, as LLM_MODEL is today)"
    # The key goes to the core's config, never its environment. Once stored it
    # can be dropped from spine.env: a boot without it keeps the stored one.
    # Every call here ends in `|| die`: this block runs in a subshell whose
    # status is tested, and bash ignores set -e inside one, so a failed call
    # would otherwise fall through to "ready" and every turn would 401.
    # Native tool calls, on unless SPINE_NATIVE_TOOLS=0. The core treats a
    # local-openai endpoint as unable to take `tools` and otherwise prompts a
    # JSON-in-tag text protocol, which Surplus (glm-5.3-flash) breaks: its
    # server reads each <tool_call> body as the tool's name, so a scheduled agent's
    # every call after the first failed as `unknown tool `{"arguments":…}``.
    # Set it to 0 only for an endpoint whose model cannot take `tools`.
    native_tools=true
    [ "${SPINE_NATIVE_TOOLS:-1}" = 0 ] && native_tools=false
    oh config_update_local_ai_settings "$(jq -cn --arg k "${LADDER_API_KEY:-}" --argjson n "$native_tools" \
      '{runtime_enabled: true, opt_in_confirmed: true, native_tool_calling: $n} + (if $k != "" then {api_key: $k} else {} end)')" >/dev/null ||
      die "model: the core did not store the model settings (the key above); every turn would fail"
    log "model: native tool calls $([ "$native_tools" = true ] && echo on || echo "off (SPINE_NATIVE_TOOLS=0)")"
    [ -n "${LADDER_API_KEY:-}" ] || log "model: no LADDER_API_KEY; keeping the key the core already stores"
    oh config_update_model_settings "$(jq -cn --arg m "$SPINE_MODEL" '("local-openai:" + $m) as $p |
      {default_model: $m, chat_provider: $p, reasoning_provider: $p, agentic_provider: $p,
       coding_provider: $p, vision_provider: $p, memory_provider: $p}')" >/dev/null ||
      die "model: the core did not take $SPINE_MODEL as its model"
    log "model: $LADDER_URL as local-openai:$SPINE_MODEL"
    # The core never asks a local-openai endpoint for the model's window and
    # budgets an unknown one at a few thousand tokens: less than its own
    # system prompt, so the trim drops the user's message and the model
    # answers an empty turn. SPINE_CONTEXT_WINDOW wins; else the endpoint's
    # own listing (the ladder reports `context_length`). The key goes in a
    # header file, never in curl's argv.
    # bin/studio's writer and editor ask for their own models per turn
    # (STUDIO_WRITER_MODEL, STUDIO_EDITOR_MODEL in secrets/teeny.env). The core
    # budgets those the same few thousand tokens, so a studio turn on them
    # came back "messages: at least one message is required" (the preview of
    # 2026-11-18), until each has its window here too (bin/lib/model_windows.sh).
    register_windows
  else
    log "model: not configured (no LADDER_URL in $env_file)"
  fi
  # The captcha solver's key (bin/lib/core_sections/automation.py turns the
  # solver on): stored as the core's `typesafe` credential, never its
  # environment. Once stored it can be dropped from spine.env.
  if [ -n "${TYPESAFE_API_KEY:-}" ]; then
    oh auth_store_provider_credentials "$(jq -cn --arg k "$TYPESAFE_API_KEY" \
      '{provider: "provider:typesafe", token: $k, setActive: true}')" >/dev/null ||
      die "captcha: the core did not store the TypeSafe key"
    log "captcha: TypeSafe key stored; browser tasks try a CAPTCHA before stopping for a person"
  else
    log "captcha: no TYPESAFE_API_KEY in $env_file; keeping the key the core already stores, if any"
  fi
  # Surplus Intelligence, where the solver asks by default
  # (TEENY_CAPTCHA_PROVIDER): its key is the core's `surplus` credential.
  if [ -n "${SURPLUS_API_KEY:-}" ]; then
    oh auth_store_provider_credentials "$(jq -cn --arg k "$SURPLUS_API_KEY" \
      '{provider: "provider:surplus", token: $k, setActive: true}')" >/dev/null ||
      die "captcha: the core did not store the Surplus key"
    log "captcha: Surplus key stored"
  else
    log "captcha: no SURPLUS_API_KEY in $env_file; keeping the key the core already stores, if any"
  fi
  if [ -n "${CORTEX_API_URL:-}" ]; then
    result="$(oh memory_engine_set "$(jq -cn --arg u "$CORTEX_API_URL" --arg k "${CORTEX_API_KEY:-}" \
      '{engine: "cortexdb", endpoint: $u} + (if $k != "" then {api_key: $k} else {} end)')")" ||
      die "memory: the core did not take cortexdb at $CORTEX_API_URL"
    status="$(jq -r '.status // "unknown"' <<<"$result")"
    log "memory: cortexdb at $CORTEX_API_URL ($status)"
  else
    log "memory: not configured (no CORTEX_API_URL in $env_file)"
  fi
) || boot_failed "configuring the core failed"

# The Gateway's lockdown, read from the config the core wrote for it, and
# OpenClaw's own security audit of that config. The core writes the file before
# it starts the Gateway and again after the settings above; wait for it, then
# refuse the boot when a flag is wrong or the audit finds anything critical.
gateway_config="$TEENY_STATE/openclaw/openclaw.json"
for _ in $(seq 1 30); do
  [ -s "$gateway_config" ] && break
  kill -0 "$core" 2>/dev/null || boot_failed "the core exited before it wrote the Gateway's config"
  sleep 1
done
[ -s "$gateway_config" ] || boot_failed "the core did not write the Gateway's config ($gateway_config)"
lock="$(python3 "$TEENY_ROOT/bin/lib/gateway_check.py" lockdown "$gateway_config")" ||
  boot_failed "the Gateway's config is not locked down: $lock"
log "gateway: $lock"
audit="$(timeout 120 "$core_bin" openclaw security audit --json 2>/dev/null | python3 "$TEENY_ROOT/bin/lib/gateway_check.py" audit)" ||
  boot_failed "openclaw security audit: ${audit#* }"
log "gateway: openclaw security audit: $audit"

if [ "$lab" = 1 ]; then
  log "lab: no cron seeded"
else
  # Cron is the Gateway's: its automations answer only once it is up, and the settings above made the core restart
  # it (once, after a pause). Wait for it to take a cron_list rather than seeding into a Gateway that is coming
  # back, then seed, all under one deadline (bin/lib/boot_cron.sh) so an unreachable Gateway fails the boot.
  boot_seed_cron "$core" "$TEENY_ROOT/bin/seed-cron" && rc=0 || rc=$?
  case "$rc" in
    0) ;;
    2) boot_failed "the core exited while the Gateway was starting" ;;
    *) boot_failed "the OpenClaw Gateway did not take cron within ${SPINE_CRON_SECS:-600}s (waiting, then seeding)" ;;
  esac
fi

# The broker (bin/broker, docs/mind.md): how the agentic mind acts on the
# world from inside its jail. It runs here, outside any jail, beside the
# core, and only while the operator has MIND=1 in secrets/teeny.env, read
# as every hand reads a setting (`bin/broker enabled`; the same switch
# enables every job that runs the `mind` agent). It mints a
# fresh token into state/home/ at every start. Never on a lab spine: a lab
# has no hands to call. A broker that will not start is logged, never a
# reason to refuse the boot: the mind's wakes then find nothing to act
# through and say so in its journal.
broker=""
if [ "$lab" = 1 ]; then
  log "broker: off (a lab spine)"
elif "$TEENY_ROOT/bin/broker" enabled; then
  "$TEENY_ROOT/bin/broker" serve &
  broker=$!
  trap 'kill -TERM "$core" 2>/dev/null || true; kill -TERM "$broker" 2>/dev/null || true' TERM INT
  log "broker: started for the agentic mind (pid $broker)"
else
  # Off means off: the switch already disables the pinned `mind` job and
  # every `agent = "mind"` job of the brain's (bin/lib/cron_policy.py); the
  # wakes the mind set for itself live only in the core, so they go here.
  "$TEENY_ROOT/bin/broker" sweep || log "broker: could not remove the mind's own wakes"
  log "broker: off (MIND is not 1 in secrets/teeny.env)"
fi
log "ready"

# A trapped signal interrupts `wait` before the core has finished shutting
# down; keep waiting until it is actually gone.
status=0
while :; do
  if wait "$core"; then status=0; else status=$?; fi
  kill -0 "$core" 2>/dev/null || break
done
[ -z "$broker" ] || kill -TERM "$broker" 2>/dev/null || true
log "the core exited with status $status"
exit "$status"
