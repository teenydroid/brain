#!/usr/bin/env bash
# Run one agent turn on the core and print the answer.
#
#   bin/ask [--agent ID] [--thread ID] [--model M] [--cwd DIR] MESSAGE...
#   echo MESSAGE | bin/ask [--agent ID]
#
# Without --agent the turn runs as the core's orchestrator. --model asks the
# core to run this one turn on model M (`model_override`; the agent's
# definition is not touched), and --cwd roots the turn's file and shell tools
# in DIR (bin/evolve's evolver agent, on a lab spine). This is the
# operator's way in (it replaces the Rust bot's bearer-authenticated
# /agent/run): whoever can run it holds the core token, so it is never wired
# to anything the public can reach.
set -euo pipefail
# shellcheck source=bin/lib/teeny.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/teeny.sh"
need jq

agent=""
thread=""
model=""
cwd=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) agent="$2"; shift 2 ;;
    --thread) thread="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --cwd) cwd="$2"; shift 2 ;;
    --) shift; break ;;
    -*) die "usage: bin/ask [--agent ID] [--thread ID] [--model M] [--cwd DIR] MESSAGE..." ;;
    *) break ;;
  esac
done
if [ $# -gt 0 ]; then
  message="$*"
else
  message="$(cat)"
fi
# A regex, not ${message//[[:space:]]/}: that substitution is quadratic in
# bash, and stalls for minutes on a long playbook or judge message.
[[ "$message" =~ [^[:space:]] ]] || die "nothing to ask"

params="$(jq -cn --arg m "$message" --arg a "$agent" --arg t "$thread" --arg o "$model" --arg c "$cwd" \
  '{message: $m} + (if $a != "" then {agent_id: $a} else {} end)
                 + (if $t != "" then {thread_id: $t} else {} end)
                 + (if $o != "" then {model_override: $o} else {} end)
                 + (if $c != "" then {cwd: $c} else {} end)')"
answer="$(oh inference_agent_chat "$params")"
# The turn's text when the answer carries one, else the whole payload.
jq -r 'if type == "string" then .
       elif type == "object" then (.response // .text // .message // .content // .) | if type == "string" then . else tojson end
       else tojson end' <<<"$answer"
