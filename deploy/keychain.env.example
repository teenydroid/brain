# secrets/keychain.env: the key hands/keychain seals Teeny's site passwords
# with (AES-256-GCM, state/keychain.db). Not committed, mode 600, never
# printed. 32 random bytes, base64. Without it the keychain is off: no login
# is offered to the browser operator and a signup that needs a password ends
# needs_human. Losing it loses every stored password; rotating it means
# re-creating the accounts.
KEYCHAIN_KEY=
