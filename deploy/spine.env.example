# secrets/spine.env: what bin/spine tells the core at every boot. Copy this
# file to secrets/spine.env (gitignored, mode 0600) and fill it in.
#
# Only LADDER_URL reaches the core's environment. The keys are written into the
# core's encrypted store (brain/storage.db, under secrets/openhuman.key) and
# can be deleted from this file once the spine has booted with them.

# The model: any OpenAI-compatible endpoint, run as the core's `local-openai`
# runtime, so no TinyHumans account is needed. SPINE_MODEL is the model id
# every workload uses.
LADDER_URL=http://ladder:6969/v1
LADDER_API_KEY=
SPINE_MODEL=
# The model's context window in tokens. Leave unset to read it from the
# endpoint's /models listing (the ladder reports it); set it for an endpoint
# that does not.
# SPINE_CONTEXT_WINDOW=
# Native tool calls (OpenAI `tools`) are on. Set 0 only for a model that cannot
# take `tools`; the text protocol that replaces them breaks on Surplus.
# SPINE_NATIVE_TOOLS=1
# A fallback model on the same endpoint (docs/roadmap.md, A18). When the main
# model fails two health checks in a row (bin/health, every 15 minutes) and
# this one answers, the running core is moved to it, with a note in the
# diary; the main one answering again moves it back. Unset: no fallback.
# SPINE_FALLBACK_MODEL=
# Its context window in tokens. Set it with the model: bin/health does not read
# the endpoint's listing, and the core budgets a model it has no window for at
# a few thousand tokens, so its turns would come back empty.
# SPINE_FALLBACK_CONTEXT_WINDOW=

# Memory: a CortexDB the core's memory engine reads and writes. Leave unset to
# run without memory. deploy/compose.yaml runs one as the `cortexdb` service:
# CORTEX_API_URL=http://127.0.0.1:3141 (the spine shares its network
# namespace) and no CORTEX_API_KEY; deploy/cortex.env.example has the one-off
# step that stores the key the core asks for.
CORTEX_API_URL=
CORTEX_API_KEY=
