# secrets/spine.env: what bin/spine tells the core at every boot. Copy this
# file to secrets/spine.env (gitignored, mode 0600) and fill it in.
#
# Only LADDER_URL reaches the core's environment. The keys are written into the
# core's encrypted store (brain/storage.db, under secrets/openhuman.key) and
# can be deleted from this file once the spine has booted with them.

# The model: any OpenAI-compatible endpoint, run as the core's `local-openai`
# runtime, so no TinyHumans account is needed. SPINE_MODEL is the model id
# every workload uses.
LADDER_URL=http://ladder:6969/v1
LADDER_API_KEY=
SPINE_MODEL=
# The model's context window in tokens. Leave unset to read it from the
# endpoint's /models listing (the ladder reports it); set it for an endpoint
# that does not.
# SPINE_CONTEXT_WINDOW=

# Memory: a CortexDB the core's memory engine reads and writes. Leave unset to
# run without memory. deploy/compose.yaml runs one as the `cortexdb` service:
# CORTEX_API_URL=http://cortexdb:3141 and CORTEX_API_KEY the same value as in
# secrets/cortex.env (deploy/cortex.env.example).
CORTEX_API_URL=
CORTEX_API_KEY=
