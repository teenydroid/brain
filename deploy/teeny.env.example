# secrets/teeny.env: the hands' keys and switches, read by each hand itself
# (hands/lib/teeny_hands/hand.py). Copy to secrets/teeny.env (gitignored, mode
# 0600). Nothing here reaches the core or the model. The process environment
# cannot change these values; it can only force DRY_RUN on.

# Off only when this says 0. Every acting verb honours it.
DRY_RUN=1

# hands/x: X API v2, OAuth 1.0a user context for writes, app bearer for reads.
X_BOT_USERNAME=teenydroid
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# X_CACHE_ENABLED=true
# X_CACHE_POST_TTL_DAYS=30
# X_CACHE_SEARCH_TTL_MINUTES=10
# X_SEARCH_MAX_RESULTS=10
# POST_MIN_GAP_HOURS=7
# POST_GAP_TOLERANCE_MINUTES=20
# REPLY_MIN_INTERVAL_MS=30000
# REPLY_MAX_INTERVAL_MS=60000
# GIPHY_API_KEY=
# Endpoints, for tests and proxies only:
# X_API_BASE=https://api.x.com
# GIPHY_API_BASE=https://api.giphy.com

# hands/gh: Teeny's GitHub account. A token for that account only, scoped to
# public repositories (a classic token's public_repo: a fine-grained one cannot
# open pull requests on other people's repos). Pushes happen only from
# state/workbench/, to its own repos.
GITHUB_TOKEN=
GITHUB_USER=teenydroid
# GH_MAX_EXTERNAL_PRS_PER_DAY=2
# GH_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# GITHUB_API_BASE=https://api.github.com
# GITHUB_GIT_BASE=https://github.com

# hands/guard: the content filter.
# MAX_EMOJI_PER_POST=1
# SAFETY_JUDGE=1
# SAFETY_JUDGE_MODEL=
# LINK_ALLOWLIST=
