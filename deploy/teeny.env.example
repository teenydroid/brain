# secrets/teeny.env: the hands' keys and switches, read by each hand itself
# (hands/lib/teeny_hands/hand.py). Copy to secrets/teeny.env (gitignored, mode
# 0600). Nothing here reaches the core or the model. The process environment
# cannot change these values; it can only force DRY_RUN on.

# Off only when this says 0. Every acting verb honours it.
DRY_RUN=1

# Where mentions and mail go: `mind` (the default) is Teeny's one inbox, read
# by bin/tick on the teeny:mind thread; `core` is the old path, the core's
# inbound queue and its per-surface drafting agents.
TEENY_INBOX=mind
# When Teeny sleeps, in its own time (CALENDAR_TZ): beats only gather between
# these hours, except for something urgent. `off` keeps it awake.
TEENY_QUIET_HOURS=1-7

# hands/x: X API v2, OAuth 1.0a user context for writes, app bearer for reads.
X_BOT_USERNAME=teenydroid
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# X_CACHE_ENABLED=true
# X_CACHE_POST_TTL_DAYS=30
# X_CACHE_SEARCH_TTL_MINUTES=10
# X_SEARCH_MAX_RESULTS=10
# Original posts a UTC day (default 4) and the hours between them (default 5).
# Ceilings, not quotas: a post needs an anchor and passes the anchor judge.
# Quotes are not counted: they have their own lane, below.
# X_POSTS_MAX_PER_DAY=4
# POST_MIN_GAP_HOURS=5
# The quote lane: quotes a UTC day (default 2; so the day's ceiling is 4
# originals plus 2 quotes), hours from one quote to the next (default 3), and
# minutes a quote waits after an original post (default 45; an original post
# never waits for a quote).
# X_QUOTES_MAX_PER_DAY=2
# QUOTE_MIN_GAP_HOURS=3
# QUOTE_AFTER_POST_MINUTES=45
# The outward quote (hands/x peer-suggest, the peer-quote playbook): only a
# suggestion scored at least this (1 to 5: how hard it hits a reader of the
# quoted post) is posted. Peers are brain/x-peers.txt; trending posts come
# from hands/trend top. (PEER_QUOTES_MAX_PER_DAY is gone: X_QUOTES_MAX_PER_DAY
# is the one daily number.)
# PEER_QUOTE_MIN_RELEVANCE=4
# POST_GAP_TOLERANCE_MINUTES=20
# How far back an own post is compared for a near-duplicate (1 to 90 days).
# REPEAT_WINDOW_DAYS=30
# The person who runs the account: bin/doctor warns until the X bio says it
# is automated and names this handle (docs/hands.md, "Saying what it is").
# X_OPERATOR_HANDLE=
# hands/x like: off. X's rules allow only likes the account holder starts,
# and every like here is chosen by a model. 1 turns the verb back on.
# X_LIKES=0
# REPLY_MIN_INTERVAL_MS=30000
# REPLY_MAX_INTERVAL_MS=60000
# Giphy: `hands/meme gif-search` finds reaction GIFs with it, and hands/x
# fetches a post's `gif_id` with it. Unset, the search answers "unavailable"
# and a post with a gif_id is refused. Giphy's terms ask for a "Powered by
# GIPHY" mention where its search is shown to people.
# GIPHY_API_KEY=
# Endpoints, for tests and proxies only:
# X_API_BASE=https://api.x.com
# twitr.sh: a pay-per-call X API paid from the wallet over x402 (hands/x,
# docs/hands.md "twitr.sh"). Off unless switched on. Reads that fail on twitr
# fall back to the X API; writes never fall back.
# X_TWITR_READS=false
# X_TWITR_WRITES=false
# The X handle linked to the wallet with `hands/x twitr-connect` (writes).
# TWITR_ACCOUNT=teenydroid
# Every payment is pinned to this network: Base, where the link was signed.
# TWITR_NETWORK=eip155:8453
# The most one call may pay, in dollars (a post or reply is $0.036).
# TWITR_MAX_PER_CALL_USD=0.05
# TWITR_API_BASE=https://twitr.sh
# GIPHY_API_BASE=https://api.giphy.com

# hands/gh: Teeny's GitHub account. A token for that account only, scoped to
# public repositories (a classic token's public_repo: a fine-grained one cannot
# open pull requests on other people's repos). Pushes happen only from
# state/workbench/, to its own repos: what the builder agent made goes out
# through `hands/build ship` (bin/build-ship), and only with DRY_RUN=0.
GITHUB_TOKEN=
GITHUB_USER=teenydroid
# Who Teeny commits as, everywhere (hands/gh pushes, bin/receipts). Defaults to
# Teeny <teeny@agentmail.to>; `hands/git check` shows what is in effect.
GIT_NAME=Teeny
GIT_EMAIL=teeny@agentmail.to
# GH_MAX_EXTERNAL_PRS_PER_DAY=2
# Put Teeny's own pull requests with red checks back on the builder's desk as
# fix jobs on the same branch, at most 3 a PR (hands/build babysit). Off (0).
# BUILD_BABYSIT=0
# Contribute to OpenHuman upstream (docs/roadmap.md, A8): `hands/build upstream`
# takes one gap of docs/oh-gaps.md, the builder closes it in a clone, and it
# opens as one disclosed pull request from Teeny's fork, under the external PR
# cap above and the project's contributing policy. Off (0).
# BUILD_UPSTREAM=0
# Publish each finished day's diary page to the diary repository's days/ with
# the receipts (bin/receipts, docs/roadmap.md A14), after the secret gate and
# the guard, hash-chained. Needs DRY_RUN=0 like the receipts. Off (0).
# DIARY_PUBLISH=0
# Publish each dream's snapshot of MEMORY.md (bin/dream) to the diary
# repository's memory/ with the receipts, one commit per snapshot so its
# history shows the page evolve: redacted by code (chat ids, emails, wallet
# addresses, off-allowlist links), then the secret gate and the guard,
# hash-chained (bin/lib/diary_memory.py). Needs DRY_RUN=0. Off (0).
# MEMORY_PUBLISH=0
# GitHub into the mind's inbox (hands/gh ingest, the pinned gh-inbound job):
# notifications on Teeny's repositories and mentions anywhere, and new stars,
# screened by the inbound guard. Off (0) by default; the token must be able to
# read notifications (a classic token's `notifications` scope).
# GH_INBOUND=0
# The pull-request babysitter (hands/babysit, bin/babysit): every 20 minutes it
# audits the open pull requests on BABYSIT_REPOS in code (prompt injection,
# secrets, frozen and sensitive paths, the diary's layout, CI, approvals) and
# logs every injection attempt. The audit always runs and writes nothing to
# GitHub. BABYSIT=1 adds labels and one audit comment per head; BABYSIT_MERGE=1
# merges a pull request whose audit is `ready`: approved by a trusted person
# (an operator for frozen or sensitive paths) at its exact head, green, clean.
# Merges are L4 (evals/autonomy.toml, merge) and capped per UTC day (3, max 10).
# BABYSIT=0
# BABYSIT_MERGE=0
# BABYSIT_MERGES_PER_DAY=3
# BABYSIT_MERGE_METHOD=merge
# BABYSIT_REPOS=teenydroid/brain,teenydroid/diary
# BABYSIT_OPERATORS=senamakel
# BABYSIT_MAINTAINERS=
# BABYSIT_MAX_FILES=100
# BABYSIT_MAX_LINES=3000
# GH_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# GITHUB_API_BASE=https://api.github.com
# GITHUB_GIT_BASE=https://github.com

# hands/moltbook: Teeny's Moltbook agent. Get the key with
# `hands/moltbook register --name teenydroid --description "..."` (it is printed
# once and never stored by the hand), then complete the claim. The base must be
# https://www.moltbook.com: the bare domain redirects and drops the key.
MOLTBOOK_API_KEY=
# MOLTBOOK_AGENT_NAME=teenydroid
# When the claim completed (epoch seconds or ISO date): the first 24 hours
# after it get Moltbook's new-agent limits. Unset, the first accepted post
# starts that clock.
# MOLTBOOK_CLAIMED_AT=
# MOLTBOOK_MAX_POSTS_PER_DAY=3
# MOLTBOOK_MAX_COMMENTS_PER_DAY=30
# A verification challenge the parser cannot read goes to two model reads
# through the core (moltbook/model_read.py); 0 leaves it for the operator.
# MOLTBOOK_CHALLENGE_MODEL=1
# MOLTBOOK_CACHE_ENABLED=true
# Endpoint, for tests and proxies only:
# MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1

# hands/reddit: Teeny on Reddit, through the browser operator's desk (no key:
# the account is made by `hands/reddit signup`, its password sealed in the
# keychain). It writes only in deploy/reddit-subreddits.txt. Its caps, over
# the last 24 hours, clamped to the ceiling in brackets; the mind's
# reddit_* intents read the same settings, and 0 takes one off.
# REDDIT_COMMENTS_PER_DAY=6     (20; comments and replies together)
# REDDIT_POSTS_PER_DAY=1        (3; 6 hours apart, from day 7 and 50 comment karma)
# REDDIT_VOTES_PER_DAY=15       (40; each target counts)
# REDDIT_SUBSCRIBES_PER_DAY=3   (10)

# hands/hn: Hacker News, read only (no key; HN has no write API). Teeny's
# account, whose direct replies `hn inbox` files into the mind's inbox; with
# it, or a watched thread, bin/tick reads HN every 15 minutes.
# HN_USERNAME=
# HN_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# HN_API_BASE=https://hacker-news.firebaseio.com/v0
# HN_SEARCH_BASE=https://hn.algolia.com/api/v1

# hands/mail: Teeny's AgentMail inbox. The inbox id is its address.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# MAIL_MAX_SENDS_PER_DAY=20
# MAIL_CACHE_ENABLED=true
# Endpoint, for tests and proxies only:
# AGENTMAIL_API_BASE=https://api.agentmail.to/v0

# hands/telegram: Teeny as a Telegram bot (make one with @BotFather; to
# read a group's whole talk, not only mentions, turn its privacy mode off:
# /setprivacy -> Disable). Every beat of bin/tick reads what came in.
# TELEGRAM_OWNERS: your Telegram user ids, comma separated (ask
# @userinfobot); your DMs reach Teeny as its makers' and wake it at night.
# TELEGRAM_CHATS: the group ids it takes part in (unset: any group it was
# added to). TELEGRAM_OPEN_DMS=1 lets strangers DM it too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNERS=
# TELEGRAM_CHATS=
# TELEGRAM_OPEN_DMS=0
# TELEGRAM_MAX_SENDS_PER_DAY=60
# TELEGRAM_MAX_PER_CHAT_HOUR=8
# Endpoint, for tests and proxies only:
# TELEGRAM_API_BASE=https://api.telegram.org

# hands/slopcash: Teeny's project on slop.cash. No key: the operator verbs
# (post-job, check, setup) sign in with GitHub in a browser each time, and the
# session never leaves the process. GITHUB_TOKEN above, when set, only raises
# GitHub's read rate limit for the submissions.
# SLOPCASH_PROJECT=teeny-s-brain
# SLOPCASH_SIGNIN_TIMEOUT_SECONDS=300
# SLOPCASH_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# SLOPCASH_API_BASE=https://slop.cash
# SLOPCASH_IDENTITY_BASE=https://identity.slop.cash

# hands/wallet: Teeny's own wallet, Solana and EVM (Base, Arbitrum, Ethereum,
# Optimism) from one recovery phrase. The keys live in the core (made once
# with bin/wallet-setup); these are the hard caps every payment is held to, by
# the hand and by the core's [wallet_policy] (bin/lib/wallet_config.py writes it
# at every boot). Once any WALLET_* key is set, all four caps must be: bin/doctor
# refuses to boot wallet keys with a cap missing, zero or over its ceiling
# (per payment 500, per day 2000, per recipient a week 2000, SOL price 10000).
# WALLET_CLUSTER=devnet
# WALLET_MAX_PER_TX_USD=
# WALLET_MAX_PER_DAY_USD=
# WALLET_MAX_PER_RECIPIENT_WEEK_USD=
# What one SOL counts as, in dollars, for the caps. There is no price feed: set
# it at or above the market price, so a SOL payment counts for at least what it
# is worth and the caps bind early. USDC counts one for one.
# WALLET_SOL_USD=
# A Solana JSON-RPC endpoint (it may carry a provider key). Unset, the cluster's
# public one. The core is given the same endpoint.
# SOLANA_RPC_URL=
# Optional, each switching on one more thing; unset, it is refused. EVM needs
# WALLET_CLUSTER=mainnet. What one ETH counts as (as with SOL: at or above the
# market; ceiling 100000). Without it no ETH moves; USDC on EVM still can.
# WALLET_ETH_USD=
# Swaps and bridges, by input value, in any 24 hours (ceiling 2000), and the
# most one may lose to fees and slippage, in basis points of its input
# (default 300, at most 1000). Without the first, neither runs.
# WALLET_MAX_CONVERT_PER_DAY_USD=
# WALLET_MAX_CONVERT_LOSS_BPS=300
# Who quotes them. Unset: bridges through LI.FI, swaps through deBridge, each
# the cheaper on small amounts. A deBridge bridge of 0.124 SOL to Base lost
# about 22% to its flat fee, LI.FI about 3%; a 0.1 SOL swap on Solana is about
# 0.6% through deBridge, 3.1% through LI.FI (docs/hands.md, "swap and
# bridge"). Set lifi or debridge to send both kinds through one.
# WALLET_CONVERT_PROVIDER=
# Optional API keys: each only raises that provider's rate limit.
# LIFI_API_KEY=
# DEBRIDGE_API_KEY=
# Paid HTTP requests (x402): the most one may cost (ceiling 5) and the most in
# any 24 hours (ceiling 100). Both or neither; without them none is paid. The
# hosts it may pay: hands/wallet x402 hosts add HOST.
# WALLET_MAX_X402_PER_REQUEST_USD=
# WALLET_MAX_X402_PER_DAY_USD=
# Let Teeny's mind move its own money through its intents (bin/lib/tick.py):
# transfers to allowlisted vendors, swaps, bridges, paid requests, all under
# the caps above. Off (0) by default; checking balances is always allowed.
# WALLET_MIND_ACTIONS=0
# The mind's three other reaches (bin/lib/tick.py, MIND_CAPS; docs/roadmap.md,
# A3): issues on Teeny's own repositories (hands/gh open-issue), browser tasks
# it writes (hands/tasks add --source teeny), and mail it starts to a contact
# (hands/mail send). Each is how many a UTC day the mind may send to its hand;
# 0 (the default) turns it off and leaves it out of the mind's prompt.
# Ceilings: 5, 20 and 5.
# MIND_ISSUES_PER_DAY=0
# MIND_TASKS_PER_DAY=0
# Sign-ups the mind may ask for (queue_signup: an account of Teeny's own, its
# password made in hands/keychain). 0 (the default) keeps it off. Ceiling 2.
# MIND_SIGNUPS_PER_DAY=0
# MIND_MAILS_PER_DAY=0
# Paid web searches and page reads (web_search, read_page through hands/x402),
# together, a UTC day. 0 (the default) keeps both off. Ceiling 50.
# MIND_SEARCHES_PER_DAY=0
# Hacker News threads the mind may start following a day (watch_hn -> hands/hn
# watch add); 0 (the default) keeps it off and out of its prompt. Ceiling 10.
# MIND_HN_WATCH_PER_DAY=0
# Changes to itself the mind may file a day (propose_change -> hands/build
# self: a pending build request from Teeny, picked by pick-request and shipped
# as a pull request you merge or close; one in flight at a time). On at 1 by
# default; 0 turns it off. Ceiling 2.
# MIND_BUILDS_PER_DAY=1
# EVM JSON-RPC endpoints (they may carry a provider key). Unset, each network's
# public one. The core is given the same endpoints.
# EVM_RPC_URL_BASE=
# EVM_RPC_URL_ARBITRUM=
# EVM_RPC_URL_ETHEREUM=
# EVM_RPC_URL_OPTIMISM=

# The $TINY mint `hands/wallet tiny` reads. Unset, the one in brain/CONTEXT.md.
# TINY_MINT=

# Teeny's public accounts (hands/wallet inflows and accounts; docs/roadmap.md,
# S1). The team's and the operator's Solana addresses, comma or space
# separated: money from them is shown apart and never counted as earned
# (unset, TINY_BUY_TEAM_ADDRESSES; with neither, every deposit is
# "unclassified"). WALLET_ACCOUNTS=1 lets the pinned accounts job close each
# week's profit and loss (Mondays); ACCOUNTS_PUBLISH=1 lets bin/receipts
# publish the closed pages to teenydroid/diary. Both off (0) by default.
# WALLET_TEAM_ADDRESSES=
# WALLET_ACCOUNTS=0
# ACCOUNTS_PUBLISH=0
# The on-chain senses (hands/wallet watch; docs/roadmap.md, A5): each deposit
# as a stimulus for the mind, and a daily $TINY balance and holder count. Read
# only. Off (0) by default.
# WALLET_WATCH=0
# The dust floors: a deposit below one is recorded (flagged `dust` in
# `hands/wallet inflows list`) but never offered to the mind, sender and all,
# because dust is how address poisoning arrives. In the asset's own units;
# 0 switches a floor off. Defaults 0.0001 SOL and 0.01 USDC.
# WALLET_DUST_SOL=0.0001
# WALLET_DUST_USDC=0.01
# Runway as a sense (bin/health runway; docs/roadmap.md, S2): the days the
# wallet's USDC lasts at this week's burn, a daily stimulus and a line in
# every beat, and the frozen tiers (evals/runway.toml) that cut pictures and
# evolve candidates when it is low. Off (0) by default.
# RUNWAY=0
# Paid build requests (hands/wallet sales; docs/roadmap.md, S3): a deposit at
# the frozen price (evals/prices.toml) whose memo names a request puts it
# first (PAID_REQUESTS), and what Teeny does not build is refunded to its
# sender under the caps and the refund limits (REQUEST_REFUNDS). Both off.
# PAID_REQUESTS=0
# REQUEST_REFUNDS=0

# hands/deploy: shipped builds as static sites at https://<slug>.DEPLOY_DOMAIN/
# (docs/roadmap.md, A11). Needs deploy/nginx/sites.teeny.enamakel.com.conf
# installed with a wildcard certificate, its root on DEPLOY_ROOT. Off (0).
# DEPLOY=0
# DEPLOY_ROOT=state/sites
# DEPLOY_DOMAIN=teeny.enamakel.com
# DEPLOY_MAX_BYTES=5000000
# DEPLOY_MAX_FILE_BYTES=1000000
# Teeny's paid endpoint (bin/paywall; docs/roadmap.md, S4): its stats for an
# x402 payment in USDC on Solana. The facilitator verifies and settles the
# buyer's payment (https only); X402_FEE_PAYER if the facilitator pays the
# network fee and names its address. Off (0): 404 until set.
# X402_ENDPOINT=0
# X402_FACILITATOR_URL=
# X402_FEE_PAYER=

# hands/x402 (docs/hands.md, "x402"). Paid web search through Exa, from the
# wallet over x402: allow the host once (hands/wallet x402 hosts add
# api.exa.ai) and set WALLET_MAX_X402_*. The most one request may pay
# (ceiling 1), text kept per result (200..10000), and the hour-long cache.
# X402_EXA_MAX_USD=0.02
# X402_TEXT_CHARS=4000
# X402_CACHE=1
# Firecrawl's x402 search: off; Firecrawl removed its x402 endpoints (June 2026).
# X402_FIRECRAWL=0
# X402_FIRECRAWL_MAX_USD=0.02
# The top-up of USDC on Base (the pinned x402-fund job, every 30 minutes),
# from the wallet's own SOL, ETH and USDC through its swap and bridge, under
# their caps (WALLET_MAX_CONVERT_PER_DAY_USD is needed). Off (0). Once on,
# the floor, the target (above the floor; ceilings 100 and 200) and the daily
# cap (ceiling 200) are required. A conversion toward Base USDC this many
# minutes old is still in flight (5..1440); ETH (in dollars at WALLET_ETH_USD)
# and SOL kept back for fees.
# X402_FUND=0
# X402_FUND_FLOOR_USD=
# X402_FUND_TARGET_USD=
# X402_FUND_MAX_PER_DAY_USD=
# X402_FUND_COOLDOWN_MIN=60
# X402_FUND_KEEP_ETH_USD=2
# X402_FUND_KEEP_SOL=0.05

# The sweep of spare SOL to the surplus wallet (hands/surplus, the pinned
# surplus-sweep job, every 2 hours), which takes only USDC on Base: USDC on
# Base above SURPLUS_KEEP_BASE_USD is paid to SURPLUS_ADDRESS, and SOL above
# SURPLUS_KEEP_SOL is bridged through LI.FI straight into USDC on Base there.
# Under the wallet's caps (WALLET_MAX_PER_RECIPIENT_WEEK_USD bounds what the
# surplus wallet gets a week; WALLET_MAX_CONVERT_PER_DAY_USD is needed). Off
# (0). Once on, the address is required, and must also be an allowlisted
# vendor: `hands/wallet vendors add surplus ADDRESS --chain base`. The payout
# (not the bridge) needs a little ETH on Base for gas (SURPLUS_MIN_GAS_ETH).
# The Base reserve is at least X402_FUND_TARGET_USD while X402_FUND=1.
# SURPLUS_SWEEP=0
# SURPLUS_ADDRESS=
# SURPLUS_KEEP_SOL=0.1
# SURPLUS_KEEP_BASE_USD=10
# SURPLUS_MIN_BRIDGE_SOL=0.05
# SURPLUS_MIN_PAYOUT_USD=1
# SURPLUS_MIN_GAS_ETH=0.00002

# Teeny pays its own server (hands/vps pay-due, the pinned pay-bills job;
# docs/roadmap.md, S5): invoices recorded with `hands/vps invoice add`, to an
# allowlisted vendor address, paid under the caps and the bill limits in
# evals/prices.toml. Off (0) by default.
# VPS_PAY_BILLS=0

# hands/world: what the team has put into Teeny's wallet, in dollars, as a
# running total. The money component of W subtracts it, so only what Teeny
# earned counts. Unset is 0.
# WORLD_TEAM_USD=

# hands/bounty: hours a winner is public before the prize is paid, so anyone
# can object (1 to 168).
# BOUNTY_CHALLENGE_HOURS=12

# Tiny Drops (hands/giveaway; the giveaway-pool fence in docs/governance.md):
# public $TINY rounds anyone can enter, paid by code from the giveaway pool,
# Solana wallet index 1 (m/44'/501'/1'/0') of the same seed. Index 0, Teeny's
# own wallet, never pays $TINY. A model only opens a round and picks the best
# reply; who entered, the draw, the payout and the clawback are code's. You
# fund the pool by sending $TINY to its address. Off (0) by default. Once on,
# every cap below is required: a missing or zero cap refuses every round.
# GIVEAWAYS=0
# The most $TINY one round's pool may hold (its distributor vault is funded
# with exactly the round's total), and the most in any 30 days.
# GIVEAWAY_POOL_MAX_TINY=
# GIVEAWAY_SEASON_MAX_TINY=
# Rounds opened in any 7 days.
# GIVEAWAY_ROUNDS_PER_WEEK=
# The most one winner may get from one round.
# GIVEAWAY_MAX_PER_WINNER_TINY=
# Days a prize may be claimed before what is unclaimed returns to the pool.
# GIVEAWAY_CLAWBACK_DAYS=
# Paid X user lookups per round (hands/x users), only for drawn candidates the
# webhook told us nothing about; entries themselves cost no reads.
# GIVEAWAY_X_LOOKUPS_PER_ROUND=
# The Solana cluster rounds settle on: devnet until a rehearsal has passed.
# The core signs and sends on its own cluster (WALLET_CLUSTER), so the two must
# agree: otherwise the giveaway wallet's policy is not written and nothing is
# signed (a devnet rehearsal is a devnet box).
# GIVEAWAY_CLUSTER=devnet
# Devnet only, and required there: a Token-2022 test mint with 6 decimals that
# stands in for $TINY (which exists on mainnet only). Published in round files.
# GIVEAWAY_DEVNET_MINT=
# The giveaway wallet's address (index 1), published in every round file as
# the distribution's authority, and a Solana JSON-RPC for GIVEAWAY_CLUSTER,
# which the draw reads its seed block from.
# GIVEAWAY_AUTHORITY=
# GIVEAWAY_RPC_URL=https://api.devnet.solana.com

# hands/stats holds no key: it reads X, Moltbook and GitHub with the keys
# above, and skips a source whose key is unset.

# hands/guard: the content filter.
# MAX_EMOJI_PER_POST=1
# SAFETY_JUDGE=1
# The model every judge asks: the guard's content judge, the anchor judge, the
# cold reader and the truth judge. Set to the studio's editor, so no judge is
# the studio's writer (and asked for every reply and Moltbook write too).
# Recommended with the studio on (a live slot posts nothing while the judges
# are the writer's model):
# SAFETY_JUDGE_MODEL=claude-opus-5.5
# The anchor judge (hands/guard anchor; bin/act asks it before an own post on X):
# on unless 0. It asks SAFETY_JUDGE_MODEL when one is set.
# ANCHOR_JUDGE=1
# The quote judge (hands/guard quote) on the outward quote: is it a reaction
# to the post it quotes? It fails open; 0 turns it off.
# QUOTE_JUDGE=1
# The cold reader (hands/guard clarity; bin/act and bin/tick ask it before an
# own post on X): a model pass that sees only the post, as someone who has
# never heard of Teeny, and must be able to say it back with nothing to ask
# about. A post it cannot follow gets one rewrite, then it is skipped. On
# unless 0. It asks SAFETY_JUDGE_MODEL when one is set, and keeps every
# verdict in state/hands.db (clarity_checks).
# CLARITY_JUDGE=1
# The truth judge (hands/guard truth): is every hard claim in a piece (money
# and the token, real people and companies, the news, safety facts) supported
# by the facts it may draw on; what Teeny invents about itself is a bit, never
# checked. bin/studio asks it before every original post. On unless 0. It
# asks SAFETY_JUDGE_MODEL when one is set, and keeps every verdict in
# state/hands.db (truth_checks, with the path that decided it).
# TRUTH_JUDGE=1
# A truth judge that cannot be reached or answers unreadably is stood in for
# by a code check: a piece with no mark of money or the token (a currency
# sign or word, a ticker, a percent, a price or wallet word) goes ahead, one
# with any is held. 1 puts the old rule back: such a judge is a no.
# TRUTH_FAIL_CLOSED=0
# The viewer check (hands/guard view): a vision model that has never heard of
# Teeny looks at a picture, meme or comic, says what it sees and copies the
# words it can read, and is shown the character sheet to say whether Teeny is
# on model. Not wired into posting yet. On unless 0. It asks Surplus's
# chat completions with SURPLUS_API_KEY (below), since the core's simple chat
# takes no pictures, and keeps every verdict in state/hands.db (viewer_checks).
# VIEWER_JUDGE=1
# A model on Surplus that takes images (default glm-5.3-flash).
# VIEWER_JUDGE_MODEL=glm-5.3-flash
# Viewer checks a UTC day (each up to nine paid asks); past it, a check is a no.
# VIEWER_MAX_PER_DAY=60
# LINK_ALLOWLIST=

# hands/image and hands/video: pictures and clips of Teeny, bought on Surplus
# Intelligence. Every picture is an edit of the character sheet.
SURPLUS_API_KEY=
# MEDIA_REFERENCE=brain/assets/teeny-reference.png
# Pictures a day (default 20: the posts plus "tag me and I'll draw us"
# replies; at $0.016 each, still under MEDIA_MAX_USD_PER_DAY).
# MEDIA_IMAGE_MAX_PER_DAY=20
# MEDIA_VIDEO_MAX_PER_DAY=2
# MEDIA_MAX_USD_PER_DAY=1.00
# MEDIA_VIDEO_MAX_USD_PER_JOB=0.20
# MEDIA_IMAGE_MODELS=
# MEDIA_VIDEO_MODELS=
# A picture over X's 5 MB still limit is re-encoded and scaled under it
# before it is saved (Pillow, python3-pil in the image).
# hands/video skit: parody videos of the public figure in a trending story,
# one take (below), or one text-to-video job a shot, cut and labelled on the reel service (which
# must be up). OFF until MEDIA_SKIT_MAX_PER_DAY is set. Every shot reserves
# MEDIA_SKIT_MAX_USD_PER_SHOT before it starts, and all of them must fit
# under MEDIA_MAX_USD_PER_DAY above with everything else bought that day, so
# raise that too. A job whose ceiling (max_cost_usdc, else its estimate) is
# over the per-shot cap is cancelled and the next model asked. The ceiling is
# about twice the bill. Seen on 2026-11-19 (5 s unless said): kling-v3-pro
# max $1.44, billed $0.72; seedance-2-0 max $1.48, billed $0.74 (its bill
# came a little after "succeeded"); veo3-1-fast 6 s max $1.54, billed $0.77.
# So a three-shot kling skit reserves about $4.31 until its shots land, then
# costs about $2.15: MEDIA_MAX_USD_PER_DAY needs about $5 of headroom for one
# skit, e.g. MEDIA_SKIT_MAX_PER_DAY=1 with MEDIA_MAX_USD_PER_DAY=6.00 (a
# second skit the same day needs about $10). A shot's length is snapped to the
# nearest one its model sells (the catalog's durations_seconds: veo 4, 6 or
# 8 s; seedance 5 to 15; kling 3 to 15).
# One take (on by default for a skit of two shots or more): the whole skit is
# ONE job, one multi-shot script with the cast's look, the setting and one
# score held throughout, so the face, the set and the music stay the same
# across hard cuts (shots made as separate jobs do not: 2026-11-20). Seen
# to follow such a script on paid renders (2026-11-20): venice-wan-3-0 (30 s
# at 720p with audio: ceiling $7.02, billed $3.04, $0.234 a second of
# ceiling; sells 2, 5, 10 ... 30 s), seedance-2-0 (15 s: ceiling $5.112,
# billed $1.42) and wan-2-7 (15 s: ceiling $3.267, billed $0.825; sells 5, 10,
# 15 s). The take is capped at the per-shot cap times the shots it replaces
# and reserves that; its length is MEDIA_SKIT_ONE_TAKE_SECS (20) snapped down
# to what the model sells, then the longest under the cap. With the $1.60
# shot cap: two shots ($3.20) get 10 s on wan-3-0 (15 s would be $3.51), 9
# s on seedance, 10 s on wan-2-7; three ($4.80) get 20 s on wan-3-0 (ceiling
# $4.68, billed about $2.03), 14 s on seedance, 15 s on wan-2-7; four ($6.40)
# 20 s, 15 s and 15 s. Each model is sent only the fields a paid render
# showed it takes: wan-3-0 resolution (MEDIA_SKIT_RESOLUTION), aspect_ratio
# and audio; seedance resolution; wan-2-7 none (MEDIA_SKIT_PARAMS goes over
# these). When the take is refused, cannot be fitted or fails unbilled on
# every one-take model, the skit falls back to one job a shot
# (MEDIA_SKIT_MODELS) in the same reservation.
# MEDIA_SKIT_ONE_TAKE=1 turns it on, 0 makes every skit one job a shot.
# MEDIA_SKIT_ONE_TAKE=1
# MEDIA_SKIT_ONE_TAKE_MODELS=venice-wan-3-0-text-to-video,seedance-2-0-text-to-video,wan-2-7-text-to-video
# MEDIA_SKIT_ONE_TAKE_SECS=20
# MEDIA_SKIT_MAX_PER_DAY=0
# MEDIA_SKIT_MAX_USD_PER_SHOT=1.60
# MEDIA_SKIT_MODELS=kling-v3-pro-text-to-video,seedance-2-0-text-to-video,wan-2-7-text-to-video,veo3-1-fast-text-to-video
# MEDIA_SKIT_SHOT_SECONDS=5
# MEDIA_SKIT_WAIT_SECONDS=900
# MEDIA_SKIT_CUT_SECONDS=300
# Extra job fields, per model or "*" for all, as JSON; {aspect}, {seconds}
# and {resolution} are filled in. The default body ({model, prompt,
# duration_seconds}) was verified on Surplus on 2026-11-19 for kling, seedance
# and veo; aspect, resolution and audio fields are not, so none is sent on a
# per-shot job by default: set them once a paid test shows what each family
# takes. (The one take sends its own verified fields, above.)
# MEDIA_SKIT_PARAMS={"*": {"aspect_ratio": "{aspect}", "resolution": "{resolution}"}}
# MEDIA_SKIT_RESOLUTION=720p
# Words added after every shot's prompt and the one-take script (a house
# look), when set.
# MEDIA_SKIT_STYLE=
# hands/video remake-keys and remake: a popular short re-made shot by shot,
# each source shot's first frame edited into the new cast plus Teeny (a
# keyframe), then animated, trimmed to the source shot and cut with the
# source's own audio and the label on the reel service (which must be up).
# A remake is one of the MEDIA_SKIT_MAX_PER_DAY videos a day it shares with
# skits, and MEDIA_MAX_USD_PER_DAY above is shared too.
# OFF until set: its own switch, and MEDIA_SKIT_MAX_PER_DAY must allow it too.
# MEDIA_REMAKE_MAX_PER_DAY=0
# Reserved a shot before anything is bought: its keyframe's estimate comes
# off it, and a clip whose ceiling (max_cost_usdc) is over what is left is
# cancelled, or, where the ceiling a second is known (wan-3-0 $0.234 at
# 720p, wan-2-7 $0.218), never asked. At $1.20 less a $0.10 key, $1.10 is
# left: wan-3-0 fits only a 1-2 s shot (its 2 s), wan-2-7 a 5 s one ($1.09;
# billed $0.47 on 2026-11-20), kling-v3-standard 5 s too ($0.98, billed
# $0.49). For wan-3-0's 5 s raise this to 1.30, for its 10 s to 2.50. A
# six-shot remake reserves six times this until it lands.
# MEDIA_REMAKE_MAX_USD_PER_SHOT=1.20
# The keyframe edits, in order: these kept the source frame, drew a
# recognisable named figure and an on-model Teeny (2026-11-20: nano-banana-2
# $0.10, seedream-v5-pro $0.06, muse $0.02 with Teeny a little off-model);
# qwen-image-2-edit redraws the whole room, so it is not one of them.
# MEDIA_REMAKE_EDIT_MODELS=nano-banana-2-edit,seedream-v5-pro-edit,muse-image-edit
# Image-to-video, in order. venice-wan-3-0 first, like the skit's one take
# (it sells 2, 5, 10, 15 to 30 s; $0.13/s at 720p); kling-v3-standard took a
# keyframe with a real face (2026-11-20).
# MEDIA_REMAKE_MODELS=venice-wan-3-0-image-to-video,wan-2-7-image-to-video,kling-v3-standard-image-to-video,kling-v3-pro-image-to-video,veo3-1-fast-image-to-video
# wan-3-0's resolution (480p $0.065/s, 720p $0.13/s, 1080p $0.26/s): it is
# sent with the remake's aspect ratio, and audio only when the cut keeps the
# clips' own sound.
# MEDIA_REMAKE_RESOLUTION=720p
# The tail every keyframe's prompt ends with: keeps the source's look and
# keeps text, logos and the character sheet out of the picture.
# MEDIA_REMAKE_STYLE=Keep the framing, the set and the lighting of the first image. Photorealistic. No text, no captions, no logos or brand names, no character sheet.
# Extra image-to-video job fields, as MEDIA_SKIT_PARAMS ({aspect}, {seconds},
# {resolution}), laid over wan-3-0's built-in ones; set them for another
# model once a paid test shows what it takes.
# MEDIA_REMAKE_PARAMS=
# 1: the source's audio is the cut's only sound. 0: each clip keeps its own.
# MEDIA_REMAKE_SOUND=1
# How long the keyframe edits may take together, in seconds. An edit starts
# only while 240 s (its own timeout) are left, so 300 allows a second try
# only after a quick refusal.
# MEDIA_REMAKE_KEYS_WAIT_SECONDS=300

# hands/meme: exact words drawn on Teeny's pictures by code (captions and
# 2 to 4 panel comics), and Giphy search (GIPHY_API_KEY above). Free: no model,
# no network but Giphy. Nothing here posts. Memes and comics a UTC day:
# MEME_MAX_PER_DAY=30
# hands/meme templates and template: the memegen service (deploy/compose.yaml,
# profile memegen). Known meme templates; free, local, posts nothing.
# MEMEGEN_URL=http://memegen:5000

# hands/reel: clips with Teeny's voice and captions, and songs, rendered by the
# `reel` compose service (MoneyPrinterTurbo; `--profile reel`), from Teeny's
# own pictures and clips. A render is free (local CPU, Edge voice); a track
# from `hands/reel music` is bought on Surplus with SURPLUS_API_KEY above and
# counts in MEDIA_MAX_USD_PER_DAY. Nothing here posts.
# REEL_URL=http://reel:8080
# Clips a UTC day; songs in 7 days and tracks in 7 days (each its own count).
# REEL_MAX_PER_DAY=1
# REEL_SONGS_MAX_PER_WEEK=1
# How long make waits for a render (seconds; 60..3600).
# REEL_WAIT_SECONDS=900
# Teeny's voice (an Edge neural voice: no key, exact word timing) and look.
# REEL_VOICE=en-US-AnaNeural-Female
# REEL_FONT=BeVietnamPro-Bold.ttf
# REEL_FONT_SIZE=88
# REEL_TEXT_COLOR=#FFE14D
# REEL_STROKE_COLOR=#000000
# A named bed's volume under the voice, in percent (no ducking upstream yet).
# REEL_BED_VOLUME_PCT=12
# Music on Surplus (POST /v1/music/generations): off until the first paid run
# is checked by hand, since only the route and the market are confirmed.
# REEL_MUSIC=0
# REEL_MUSIC_MODELS=elevenlabs-music-v2-5,elevenlabs-music-v2
# REEL_MUSIC_MAX_USD_PER_JOB=0.70
# REEL_MUSIC_WAIT_SECONDS=600

# hands/remake: popular short videos to study and remake (docs/hands.md,
# "remake"). charts and study are reads: they post nothing. The fetching is the
# `ingest` compose service's (`--profile ingest`): a pinned yt-dlp and ffmpeg
# with no key and no mount of Teeny's. Its one setting, INGEST_PROXY_URL (a proxy
# YouTube needs from this box), lives in secrets/ingest.env
# (deploy/ingest.env.example), not here: the hands never see it.
# INGEST_URL=http://ingest:8090
# Which charts to read. TikTok: a comma list of account names whose recent videos
# are listed (default none: off). YouTube: the Data API's most-popular chart, with
# a key (default none: off); the key stays in this file and the one request.
# REMAKE_TIKTOK_ACCOUNTS=
# YOUTUBE_API_KEY=
# REMAKE_REGION=US
# Videos older than this many hours are left out of charts (1..8760).
# REMAKE_MAX_AGE_HOURS=168
# `study` makes one vision call on Surplus (SURPLUS_API_KEY above), about a cent
# on glm-5.3-flash (up to 3 asks when an answer cannot be read), and runs in a dry
# room too. Studies a UTC day; 0 turns it off. A study already made is read
# again free.
# REMAKE_STUDY_MAX_PER_DAY=3
# REMAKE_STUDY_MODEL=glm-5.3-flash
# Studies' media (frames, audio, the video) is kept this many hours, then removed.
# REMAKE_KEEP_HOURS=48

# bin/studio: the writers' room (docs/architecture.md, §4b). With STUDIO=1 it
# owns every original post on X, live: the four slots in brain/cron.toml run
# it, the mind's post_x files a pitch, and the brief and the peer quote go
# past its editor first. STUDIO=0 is the whole rollback: each slot runs its
# old playbook again, the mind posts, nothing is vetoed
# (bin/lib/studio_switch.py). STUDIO_DRY=1 runs every step and every gate and
# posts nothing, buys no picture. STUDIO takes only 1/true/yes/on or
# 0/false/no/off (or unset): any other word posts nothing on either path
# and fails bin/doctor. The process environment wins over this
# file, so `bin/studio --dry-run` with any of these set previews a change
# without editing it.
# The cutover's recommended value (deploy/README.md, "The studio cutover"):
# STUDIO=1
# STUDIO_DRY=0
# The writer pitches and drafts, the editor picks: two different models, each
# sent per turn as bin/ask --model. Unset is the core's model (SPINE_MODEL). A
# model that fails a turn is dropped for the rest of the run, on the core's
# default, with a warning in the run's record (and a second one when that
# leaves writer and editor on one model).
# bin/spine reads these two at boot to register each one's context window
# (the core would otherwise trim a long turn on them to nothing): restart the
# spine after changing them. gemini-3.1-pro answered 503 no_healthy_sellers
# twice on 2026-11-18, so the editor is claude-opus-5.5.
# Recommended:
# STUDIO_WRITER_MODEL=claude-fable-5.2
# STUDIO_EDITOR_MODEL=claude-opus-5.5
# The outside world's X search (the old take/x-quote playbooks' "builders"):
# billed per post returned and cached in state/hands.db, DRY_RUN or not, so
# off unless 1. Hacker News and the listen digest are always read (free).
# STUDIO_OUTSIDE_X=0
# The formats the room may pitch (post, thread, image, meme, skit). Add meme
# only with the memegen service up (deploy/README.md, "The meme service"),
# and skit only with the reel service up and MEDIA_SKIT_MAX_PER_DAY set.
# STUDIO_FORMATS=post,thread,image
# Slots (brain/cron.toml names) where the room pitches skits first and tries
# the best one first, falling back to the other formats when the video cannot
# be made; and the longest a skit's render may take. A skit slot wants
# STUDIO_BUDGET_SECS=3600.
# STUDIO_SKIT_SLOTS=
# STUDIO_SKIT_SECS=900
# Angles pitched, how many of the best are drafted, drafts of each.
# STUDIO_PITCHES=12
# STUDIO_DRAFT_TOP=3
# Of those drafted, how many are kept for an invention-led pitch (a tall
# tale, grudge, lore bit or threat) whenever the pitches hold one, whatever
# the writer's own ranking. 0 drafts the ranking alone.
# STUDIO_DRAFT_INVENTED=1
# STUDIO_DRAFTS_EACH=3
# The editor's tournament: how many others each draft meets, pairs a turn.
# STUDIO_MEETINGS=3
# STUDIO_PAIRS_PER_TURN=5
# The whole run's time, one turn's most and least, and the inputs' share of
# a turn's message (the core holds a message over 64 KiB).
# STUDIO_BUDGET_SECS=2400
# STUDIO_TURN_MAX_SECS=300
# STUDIO_TURN_MIN_SECS=20
# STUDIO_INPUTS_BYTES=40000
