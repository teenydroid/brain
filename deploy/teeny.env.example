# secrets/teeny.env: the hands' keys and switches, read by each hand itself
# (hands/lib/teeny_hands/hand.py). Copy to secrets/teeny.env (gitignored, mode
# 0600). Nothing here reaches the core or the model. The process environment
# cannot change these values; it can only force DRY_RUN on.

# Off only when this says 0. Every acting verb honours it.
DRY_RUN=1

# Where mentions and mail go: `mind` (the default) is Teeny's one inbox, read
# by bin/tick on the teeny:mind thread; `core` is the old path, the core's
# inbound queue and its per-surface drafting agents.
TEENY_INBOX=mind
# When Teeny sleeps, in its own time (CALENDAR_TZ): beats only gather between
# these hours, except for something urgent. `off` keeps it awake.
TEENY_QUIET_HOURS=1-7

# hands/x: X API v2, OAuth 1.0a user context for writes, app bearer for reads.
X_BOT_USERNAME=teenydroid
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# X_CACHE_ENABLED=true
# X_CACHE_POST_TTL_DAYS=30
# X_CACHE_SEARCH_TTL_MINUTES=10
# X_SEARCH_MAX_RESULTS=10
# POST_MIN_GAP_HOURS=3
# POST_GAP_TOLERANCE_MINUTES=20
# How far back an own post is compared for a near-duplicate (1 to 90 days).
# REPEAT_WINDOW_DAYS=30
# The person who runs the account: bin/doctor warns until the X bio says it
# is automated and names this handle (docs/hands.md, "Saying what it is").
# X_OPERATOR_HANDLE=
# hands/x like: off. X's rules allow only likes the account holder starts,
# and every like here is chosen by a model. 1 turns the verb back on.
# X_LIKES=0
# REPLY_MIN_INTERVAL_MS=30000
# REPLY_MAX_INTERVAL_MS=60000
# GIPHY_API_KEY=
# Endpoints, for tests and proxies only:
# X_API_BASE=https://api.x.com
# twitr.sh: a pay-per-call X API paid from the wallet over x402 (hands/x,
# docs/hands.md "twitr.sh"). Off unless switched on. Reads that fail on twitr
# fall back to the X API; writes never fall back.
# X_TWITR_READS=false
# X_TWITR_WRITES=false
# The X handle linked to the wallet with `hands/x twitr-connect` (writes).
# TWITR_ACCOUNT=teenydroid
# Every payment is pinned to this network: Base, where the link was signed.
# TWITR_NETWORK=eip155:8453
# The most one call may pay, in dollars (a post or reply is $0.036).
# TWITR_MAX_PER_CALL_USD=0.05
# TWITR_API_BASE=https://twitr.sh
# GIPHY_API_BASE=https://api.giphy.com

# hands/gh: Teeny's GitHub account. A token for that account only, scoped to
# public repositories (a classic token's public_repo: a fine-grained one cannot
# open pull requests on other people's repos). Pushes happen only from
# state/workbench/, to its own repos: what the builder agent made goes out
# through `hands/build ship` (bin/build-ship), and only with DRY_RUN=0.
GITHUB_TOKEN=
GITHUB_USER=teenydroid
# Who Teeny commits as, everywhere (hands/gh pushes, bin/receipts). Defaults to
# Teeny <teeny@agentmail.to>; `hands/git check` shows what is in effect.
GIT_NAME=Teeny
GIT_EMAIL=teeny@agentmail.to
# GH_MAX_EXTERNAL_PRS_PER_DAY=2
# Put Teeny's own pull requests with red checks back on the builder's desk as
# fix jobs on the same branch, at most 3 a PR (hands/build babysit). Off (0).
# BUILD_BABYSIT=0
# GitHub into the mind's inbox (hands/gh ingest, the pinned gh-inbound job):
# notifications on Teeny's repositories and mentions anywhere, and new stars,
# screened by the inbound guard. Off (0) by default; the token must be able to
# read notifications (a classic token's `notifications` scope).
# GH_INBOUND=0
# GH_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# GITHUB_API_BASE=https://api.github.com
# GITHUB_GIT_BASE=https://github.com

# hands/moltbook: Teeny's Moltbook agent. Get the key with
# `hands/moltbook register --name teenydroid --description "..."` (it is printed
# once and never stored by the hand), then complete the claim. The base must be
# https://www.moltbook.com: the bare domain redirects and drops the key.
MOLTBOOK_API_KEY=
# MOLTBOOK_AGENT_NAME=teenydroid
# When the claim completed (epoch seconds or ISO date): the first 24 hours
# after it get Moltbook's new-agent limits. Unset, the first accepted post
# starts that clock.
# MOLTBOOK_CLAIMED_AT=
# MOLTBOOK_MAX_POSTS_PER_DAY=3
# MOLTBOOK_MAX_COMMENTS_PER_DAY=30
# A verification challenge the parser cannot read goes to two model reads
# through the core (moltbook/model_read.py); 0 leaves it for the operator.
# MOLTBOOK_CHALLENGE_MODEL=1
# MOLTBOOK_CACHE_ENABLED=true
# Endpoint, for tests and proxies only:
# MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1

# hands/mail: Teeny's AgentMail inbox. The inbox id is its address.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# MAIL_MAX_SENDS_PER_DAY=20
# MAIL_CACHE_ENABLED=true
# Endpoint, for tests and proxies only:
# AGENTMAIL_API_BASE=https://api.agentmail.to/v0

# hands/telegram: Teeny as a Telegram bot (make one with @BotFather; to
# read a group's whole talk, not only mentions, turn its privacy mode off:
# /setprivacy -> Disable). Every beat of bin/tick reads what came in.
# TELEGRAM_OWNERS: your Telegram user ids, comma separated (ask
# @userinfobot); your DMs reach Teeny as its makers' and wake it at night.
# TELEGRAM_CHATS: the group ids it takes part in (unset: any group it was
# added to). TELEGRAM_OPEN_DMS=1 lets strangers DM it too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNERS=
# TELEGRAM_CHATS=
# TELEGRAM_OPEN_DMS=0
# TELEGRAM_MAX_SENDS_PER_DAY=60
# TELEGRAM_MAX_PER_CHAT_HOUR=8
# Endpoint, for tests and proxies only:
# TELEGRAM_API_BASE=https://api.telegram.org

# hands/slopcash: Teeny's project on slop.cash. No key: the operator verbs
# (post-job, check, setup) sign in with GitHub in a browser each time, and the
# session never leaves the process. GITHUB_TOKEN above, when set, only raises
# GitHub's read rate limit for the submissions.
# SLOPCASH_PROJECT=teeny-s-brain
# SLOPCASH_SIGNIN_TIMEOUT_SECONDS=300
# SLOPCASH_CACHE_ENABLED=true
# Endpoints, for tests and proxies only:
# SLOPCASH_API_BASE=https://slop.cash
# SLOPCASH_IDENTITY_BASE=https://identity.slop.cash

# hands/wallet: Teeny's own wallet, Solana and EVM (Base, Arbitrum, Ethereum,
# Optimism) from one recovery phrase. The keys live in the core (made once
# with bin/wallet-setup); these are the hard caps every payment is held to, by
# the hand and by the core's [wallet_policy] (bin/lib/wallet_config.py writes it
# at every boot). Once any WALLET_* key is set, all four caps must be: bin/doctor
# refuses to boot wallet keys with a cap missing, zero or over its ceiling
# (per payment 500, per day 2000, per recipient a week 2000, SOL price 10000).
# WALLET_CLUSTER=devnet
# WALLET_MAX_PER_TX_USD=
# WALLET_MAX_PER_DAY_USD=
# WALLET_MAX_PER_RECIPIENT_WEEK_USD=
# What one SOL counts as, in dollars, for the caps. There is no price feed: set
# it at or above the market price, so a SOL payment counts for at least what it
# is worth and the caps bind early. USDC counts one for one.
# WALLET_SOL_USD=
# A Solana JSON-RPC endpoint (it may carry a provider key). Unset, the cluster's
# public one. The core is given the same endpoint.
# SOLANA_RPC_URL=
# Optional, each switching on one more thing; unset, it is refused. EVM needs
# WALLET_CLUSTER=mainnet. What one ETH counts as (as with SOL: at or above the
# market; ceiling 100000). Without it no ETH moves; USDC on EVM still can.
# WALLET_ETH_USD=
# Swaps and bridges through deBridge, by input value, in any 24 hours (ceiling
# 2000), and the most one may lose to fees and slippage, in basis points of
# its input (default 300, at most 1000). Without the first, neither runs.
# WALLET_MAX_CONVERT_PER_DAY_USD=
# WALLET_MAX_CONVERT_LOSS_BPS=300
# Optional deBridge API key: only raises deBridge's rate limit.
# DEBRIDGE_API_KEY=
# Paid HTTP requests (x402): the most one may cost (ceiling 5) and the most in
# any 24 hours (ceiling 100). Both or neither; without them none is paid. The
# hosts it may pay: hands/wallet x402 hosts add HOST.
# WALLET_MAX_X402_PER_REQUEST_USD=
# WALLET_MAX_X402_PER_DAY_USD=
# Let Teeny's mind move its own money through its intents (bin/lib/tick.py):
# transfers to allowlisted vendors, swaps, bridges, paid requests, all under
# the caps above. Off (0) by default; checking balances is always allowed.
# WALLET_MIND_ACTIONS=0
# The mind's three other reaches (bin/lib/tick.py, MIND_CAPS; docs/roadmap.md,
# A3): issues on Teeny's own repositories (hands/gh open-issue), browser tasks
# it writes (hands/tasks add --source teeny), and mail it starts to a contact
# (hands/mail send). Each is how many a UTC day the mind may send to its hand;
# 0 (the default) turns it off and leaves it out of the mind's prompt.
# Ceilings: 5, 10 and 5.
# MIND_ISSUES_PER_DAY=0
# MIND_TASKS_PER_DAY=0
# MIND_MAILS_PER_DAY=0
# EVM JSON-RPC endpoints (they may carry a provider key). Unset, each network's
# public one. The core is given the same endpoints.
# EVM_RPC_URL_BASE=
# EVM_RPC_URL_ARBITRUM=
# EVM_RPC_URL_ETHEREUM=
# EVM_RPC_URL_OPTIMISM=

# The $TINY mint `hands/wallet tiny` reads. Unset, the one in brain/CONTEXT.md.
# TINY_MINT=

# hands/world: what the team has put into Teeny's wallet, in dollars, as a
# running total. The money component of W subtracts it, so only what Teeny
# earned counts. Unset is 0.
# WORLD_TEAM_USD=

# hands/bounty: hours a winner is public before the prize is paid, so anyone
# can object (1 to 168).
# BOUNTY_CHALLENGE_HOURS=12

# hands/stats holds no key: it reads X, Moltbook and GitHub with the keys
# above, and skips a source whose key is unset.

# hands/guard: the content filter.
# MAX_EMOJI_PER_POST=1
# SAFETY_JUDGE=1
# SAFETY_JUDGE_MODEL=
# LINK_ALLOWLIST=

# hands/image and hands/video: pictures and clips of Teeny, bought on Surplus
# Intelligence. Every picture is an edit of the character sheet.
SURPLUS_API_KEY=
# MEDIA_REFERENCE=brain/assets/teeny-reference.png
# MEDIA_IMAGE_MAX_PER_DAY=8
# MEDIA_VIDEO_MAX_PER_DAY=2
# MEDIA_MAX_USD_PER_DAY=1.00
# MEDIA_VIDEO_MAX_USD_PER_JOB=0.20
# MEDIA_IMAGE_MODELS=
# MEDIA_VIDEO_MODELS=
