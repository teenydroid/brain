# secrets/cortex.env: CortexDB's keys (deploy/compose.yaml, service cortexdb).
# Not committed. One Surplus Intelligence key serves every model tier. The
# store itself takes no key: it binds loopback inside the namespace it shares
# with the spine (compose.yaml).
#
#   k="$(grep '^SURPLUS_API_KEY=' secrets/teeny.env | cut -d= -f2-)"
#   printf '%s\n' "LLM_API_KEY=$k" "OPENAI_API_KEY=$k" \
#     "CORTEX_LLM_API_KEY=$k" "CORTEX_ENRICHMENT_API_KEY=$k" "CORTEX_ANSWER_API_KEY=$k" \
#     "CORTEX_VERIFIER_API_KEY=$k" "CORTEX_EMBEDDING_API_KEY=$k" "CORTEX_ENTITY_API_KEY=$k" \
#     > secrets/cortex.env && chmod 600 secrets/cortex.env
#   echo "CORTEX_API_URL=http://127.0.0.1:3141" >> secrets/spine.env
#
# The core still wants a key on file before it turns memory on, and storing
# one goes through TinySecurity's keyring, which asks a person to approve the
# write (openhuman#8670 lets a headless core skip that). Once, by hand:
#   docker compose -f deploy/compose.yaml exec spine sh -c '
#     bin/oh memory_engine_set "{\"engine\":\"cortexdb\",\"endpoint\":\"http://127.0.0.1:3141\",\"api_key\":\"teeny-internal\"}" &
#     sleep 3; bin/oh keyring_consent_list_pending_operations "{}"'
#   # then approve the request_id it lists:
#   bin/oh keyring_consent_respond_operation '{"request_id":"<id>","approved":true}'
# bin/spine leaves CORTEX_API_KEY unset after that, so a boot never asks again.
LLM_API_KEY=
OPENAI_API_KEY=
CORTEX_LLM_API_KEY=
CORTEX_ENRICHMENT_API_KEY=
CORTEX_ANSWER_API_KEY=
CORTEX_VERIFIER_API_KEY=
CORTEX_EMBEDDING_API_KEY=
CORTEX_ENTITY_API_KEY=
