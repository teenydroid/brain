{
  "method": "openhuman.auth_store_provider_credentials",
  "call_sites": [
    "bin/spine:264",
    "bin/spine:274"
  ],
  "params": {
    "fields": {
      "provider": {
        "type": "string",
        "required": true,
        "note": "provider:typesafe | provider:surplus"
      },
      "token": {
        "type": "string",
        "required": true
      },
      "setActive": {
        "type": "boolean",
        "required": true,
        "note": "true"
      }
    },
    "example": {
      "provider": "provider:surplus",
      "token": "FAKE-TOKEN",
      "setActive": true
    }
  },
  "response": {
    "type": "any",
    "fields": {},
    "reader": "ignored"
  },
  "notes": "Response ignored; the token is never logged."
}
