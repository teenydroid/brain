{
  "method": "openhuman.web3_dapp_execute",
  "call_sites": [
    "hands/lib/teeny_hands/wallet/convert.py:571"
  ],
  "params": {
    "fields": {
      "quoteId": {
        "type": "string",
        "required": true
      },
      "confirmed": {
        "type": "boolean",
        "required": true,
        "note": "true"
      }
    },
    "example": {
      "quoteId": "q-4",
      "confirmed": true
    }
  },
  "response": {
    "type": "object",
    "fields": {
      "transactionHash": {
        "type": "string",
        "required": true
      }
    },
    "reader": "wallet/convert.py _approve",
    "example": {
      "transactionHash": "0xabc"
    }
  },
  "timeout": "120s"
}
