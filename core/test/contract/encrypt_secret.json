{
  "method": "openhuman.encrypt_secret",
  "call_sites": [
    "bin/wallet-setup:111"
  ],
  "params": {
    "fields": {
      "plaintext": {
        "type": "string",
        "required": true
      }
    },
    "example": {
      "plaintext": "word word"
    }
  },
  "response": {
    "type": "string|object",
    "fields": {
      "result": {
        "type": "string",
        "required": false,
        "note": "when an object, the ciphertext is under .result"
      }
    },
    "reader": "bin/wallet-setup: a non-empty string, or {result: string}",
    "example": "ENC[abc]"
  }
}
