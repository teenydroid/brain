# The pre-spine layout (bin/kernel): its workspace held the core's storage.db
# and encrypted secrets. The spine keeps them in brain/ now.
/workspace/
# What the core writes into the brain at boot: its own state, and its
# generic persona defaults (IDENTITY, ROLE, STYLE) with their hash sidecars.
# Teeny's SOUL.md is kept as is (the core never overwrites a file it did not
# write). Un-ignore a persona file when Teeny writes its own version of it.
/brain/state/
# Generated by the core at boot: its bundled flow-authoring skills and the
# MCP stdio scratch folder.
/brain/.openhuman/
/brain/mcp_stdio/
/brain/.*.builtin-hash
/brain/IDENTITY.md
/brain/ROLE.md
/brain/STYLE.md
/*.mp4
__pycache__/
*.pyc
/brain/agent/

# The core's file keyring (secrets, encrypted under secrets/openhuman.key)
# and its lock, and stray build logs: never committed, even by a box-local
# auto-commit.
/brain/dev-keychain.json
/brain/dev-keychain.json.lock
/*.log
